# Pixel Surveys - Apache config for VentraIP shared hosting.
# Ships inside dist/ and lands in the web root on every deploy.

Options -Indexes
DirectoryIndex index.html index.php
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force HTTPS (AutoSSL issues the certificate).
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Canonical host: www -> apex.
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  # The old WordPress site's common URLs -> nearest new page, so existing
  # links and search results don't 404 after cutover. Extend as needed.
  RewriteRule ^wp-admin/?  / [L,R=301]
  RewriteRule ^wp-login\.php$ / [L,R=301]

  # ---- Pre-launch gate ----
  # Public visitors get the "coming soon" page at /maintenance/. Whoever
  # opens https://pixelsurveys.com.au/?preview=qRWAlfZm5naV5SY5QjBp6X2b once
  # gets a cookie that unlocks the real site on every visit after that -
  # send that link to the client, not the plain domain.
  #
  # This token is a "keep the unfinished site out of public view" measure,
  # not a secret - it lives in this repo, so anyone with repo access can
  # read it. That's fine for what it does. To change it, edit both this
  # line and the Set-Cookie line below; the two have to stay in sync.
  #
  # Delete this whole "Pre-launch gate" block (both directives) once the
  # site is ready to go fully public.
  RewriteCond %{HTTP_COOKIE} !preview_access=qRWAlfZm5naV5SY5QjBp6X2b
  RewriteCond %{QUERY_STRING} !(^|&)preview=qRWAlfZm5naV5SY5QjBp6X2b(&|$)
  RewriteCond %{REQUEST_URI} !^/maintenance/
  RewriteCond %{REQUEST_URI} !^/_astro/
  RewriteCond %{REQUEST_URI} !^/api/
  RewriteRule ^ /maintenance/ [L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"

  # Astro fingerprints everything in /_astro/ - safe to cache for a year.
  <If "%{REQUEST_URI} =~ m#^/_astro/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  # HTML must revalidate so deploys show up immediately.
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  # Part of the pre-launch gate above: arriving with the right ?preview=
  # token sets the bypass cookie so it isn't needed on every visit. Keep
  # the token here in sync with the one in the mod_rewrite block.
  Header always set Set-Cookie "preview_access=qRWAlfZm5naV5SY5QjBp6X2b; Path=/; Max-Age=15552000; Secure; SameSite=Lax" "expr=%{QUERY_STRING} =~ /(^|&)preview=qRWAlfZm5naV5SY5QjBp6X2b(&|$)/"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
