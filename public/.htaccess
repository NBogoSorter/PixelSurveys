# Pixel Surveys - Apache config for VentraIP shared hosting.
# Ships inside dist/ and lands in the web root on every deploy.

Options -Indexes
DirectoryIndex index.html index.php
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force HTTPS (AutoSSL issues the certificate).
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Canonical host: www -> apex.
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  # The old WordPress site's common URLs -> nearest new page, so existing
  # links and search results don't 404 after cutover. Extend as needed.
  RewriteRule ^wp-admin/?  / [L,R=301]
  RewriteRule ^wp-login\.php$ / [L,R=301]

  # The pre-launch gate that served /maintenance/ to everyone without a preview
  # cookie was removed on 30 Sept 2026, when the site went public. The page
  # itself is still at /maintenance/ - noindex, and kept out of the sitemap - so
  # it can be put back in front of the site for a future maintenance window.
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"

  # Astro fingerprints everything in /_astro/ - safe to cache for a year.
  <If "%{REQUEST_URI} =~ m#^/_astro/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  # HTML must revalidate so deploys show up immediately.
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  # The Set-Cookie that paired with the pre-launch gate went with it on
  # 30 Sept 2026. Anyone who still holds a preview_access cookie from before
  # then is unaffected: nothing reads it any more.
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
