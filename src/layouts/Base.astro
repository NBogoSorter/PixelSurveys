---
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  /**
   * Colour behind <main>. It has flex: 1 so it grows to fill the viewport when
   * a page's content is shorter than the screen. On a page ending in a
   * full-bleed coloured section that leftover space shows the body's white
   * through, as a band between that section and the footer - which is what
   * /contact/ does on a tall monitor: one navy panel, then white, then the
   * navy footer. Setting this to the section's colour closes the seam.
   */
  mainBackground?: string;
}

const {
  title,
  description = "Drone survey & aerial mapping services - orthomosaics, terrain models, point clouds and site analysis.",
  mainBackground,
} = Astro.props;

const fullTitle = title ? `${title} | Pixel Surveys` : "Pixel Surveys";
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Pixel Surveys" />
    <meta property="og:locale" content="en_AU" />
    {/* No og:image yet - that needs a real 1200x630 share image, which waits
        on the client supplying photography. Twitter falls back to "summary"
        rather than claiming a large image that doesn't exist. */}
    <meta name="twitter:card" content="summary" />
  </head>
  <body>
    <SiteHeader />
    <main style={mainBackground ? `background: ${mainBackground};` : undefined}>
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>

<style>
  body {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  /* <main> deliberately does not grow. It carried flex: 1, so on a viewport
     taller than the content the leftover space opened up inside main, between
     the page's last section and the footer - and it looked wrong whatever
     colour it took. White read as a gap; painting it navy to match made the
     last section look like it had doubled in height. SiteFooter takes the
     growth instead, where the extra height lands below the copyright line and
     reads as page padding. */
</style>
