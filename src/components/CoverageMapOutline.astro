const PIN = "M0,0 C-7,-16 -26,-30 -26,-52 A26,26 0 1 1 26,-52 C26,-30 7,-16 0,0Z";
---

<svg
  class="map"
  viewBox="130 110 800 720"
  role="img"
  aria-label="Map of Australia with pins on Adelaide and Wollongong"
>
  <defs>
    <clipPath id={clipId}>
      <path d={MAINLAND} />
      <path d={TASMANIA} />
      <path d={KANGAROO_ISLAND} transform={KI_TRANSFORM} />
    </clipPath>
  </defs>
  <g fill="rgb(255 255 255 / 14%)">
    <path d={MAINLAND} />
    <path d={TASMANIA} />
    <path d={KANGAROO_ISLAND} transform={KI_TRANSFORM} />
  </g>
  {/* Clipped to the coastline, so the rings read as coverage over land
      rather than circles floating out to sea. */}
  <g
    fill="none"
    stroke="#fff"
    stroke-width="6"
    clip-path={`url(#${clipId})`}
    aria-hidden="true"
  >
    <circle cx="596.8" cy="622.5" r="64" opacity="0.9" />
    <circle cx="596.8" cy="622.5" r="105" opacity="0.6" />
    <circle cx="596.8" cy="622.5" r="146" opacity="0.35" />
    <circle cx="810.3" cy="612.5" r="42" opacity="0.9" />
    <circle cx="810.3" cy="612.5" r="74" opacity="0.6" />
    <circle cx="810.3" cy="612.5" r="106" opacity="0.35" />
  </g>
  <g transform="translate(596.8 622.5)">
    <path d={PIN} fill="#d3d9df" />
    <circle cx="0" cy="-52" r="10" fill="#0c538d" />
  </g>
  <g transform="translate(810.3 612.5) scale(0.65)">
    <path d={PIN} fill="#d3d9df" />
    <circle cx="0" cy="-52" r="10" fill="#0c538d" />
  </g>
</svg>

<style>
  .map {
    display: block;
    width: 100%;
    max-width: 300px;
    height: auto;
    margin-inline: auto;
  }
</style>
