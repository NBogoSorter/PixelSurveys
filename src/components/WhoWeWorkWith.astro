---
// "Who We Work With": option C2 (side tabs) from the About layout exploration,
// built at the foot of the Services page on 23 Oct 2026. Client types down the
// left, and the chosen one's photo, summary and three example deliverables on
// the right, each deliverable opening to its description.
//
// Progressive enhancement. The markup ships with every client type's panel
// showing one after another and the tab list hidden, which is a complete page
// by itself; the script adds .has-js, which hides the tabs' fallback and turns
// it into the tabbed layout.
import { Image } from "astro:assets";
import { WHO_WE_WORK_WITH } from "../data/who-we-work-with";
---

<section class="who" id="who-we-work-with" data-who>
  <div class="container">
    <h2 class="heading">Who We Work With</h2>

    <div class="layout">
      <div class="tabs" role="group" aria-label="Client type" data-tabs>
        {WHO_WE_WORK_WITH.map((group, i) => (
          <button
            type="button"
            class="tab"
            aria-pressed={i === 0 ? "true" : "false"}
            aria-controls={`who-${group.id}`}
            data-tab={group.id}
          >
            <span>{group.label}</span>
            <svg
              viewBox="0 0 24 24"
              width="16"
              height="16"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M9 6l6 6-6 6" />
            </svg>
          </button>
        ))}
      </div>

      <div class="panels">
        {WHO_WE_WORK_WITH.map((group) => (
          <div class="panel" id={`who-${group.id}`} data-panel={group.id}>
            <Image
              src={group.image}
              alt={group.alt}
              width={960}
              widths={[480, 640, 960]}
              sizes="(max-width: 760px) 100vw, 800px"
              loading="lazy"
              class="photo"
            />
            <div>
              <h3 class="panel-title">{group.label}</h3>
              <p class="panel-text">{group.text}</p>
            </div>
            <div>
              <p class="deliverables-label">Common deliverables</p>
              <ul class="items">
                {group.items.map((item) => (
                  <li>
                    <details class="item">
                      <summary>
                        <svg
                          class="chev"
                          viewBox="0 0 24 24"
                          width="13"
                          height="13"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2.5"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          aria-hidden="true"
                        >
                          <path d="M9 6l6 6-6 6" />
                        </svg>
                        <span>{item.name}</span>
                      </summary>
                      <p>{item.desc}</p>
                    </details>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))}

        <p class="more">
          Need something different? These are just a few examples.{" "}
          <a href="/contact/">Get in touch</a> or{" "}
          <a href="#all-services">view all services</a>.
        </p>
      </div>
    </div>
  </div>
</section>

<script>
  const root = document.querySelector<HTMLElement>("[data-who]");
  if (root) {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>("[data-tab]")];
    const panels = [...root.querySelectorAll<HTMLElement>("[data-panel]")];

    const show = (id: string) => {
      for (const tab of tabs) {
        tab.setAttribute("aria-pressed", String(tab.dataset.tab === id));
      }
      for (const panel of panels) {
        panel.hidden = panel.dataset.panel !== id;
      }
    };

    root.classList.add("has-js");
    for (const tab of tabs) {
      tab.addEventListener("click", () => show(tab.dataset.tab ?? ""));
    }
    show(tabs[0]?.dataset.tab ?? "");
  }
</script>

<style>
  /* The page's last section, so it owns the gap above the footer; the cards
     section above has its own bottom padding for the gap between them. */
  .who {
    /* "Who We Work With" in the homepage's Industries & Applications intro
       links here; keeps the heading clear of the sticky header. */
    scroll-margin-top: 96px;
    padding-bottom: var(--space-section);
  }

  .heading {
    font-size: clamp(29px, 3.6vw, 36px);
    font-weight: 700;
    color: var(--color-ink);
  }

  .layout {
    margin-top: var(--space-heading);
    display: flex;
    flex-wrap: wrap;
    gap: 32px;
  }

  /* Without JavaScript the tabs are of no use - every panel is already on the
     page - so they appear only once the script has run. */
  .tabs {
    display: none;
    flex: 1 1 280px;
    max-width: 340px;
    flex-direction: column;
    border-top: 1px solid var(--color-border);
    align-self: flex-start;
  }

  .has-js .tabs {
    display: flex;
  }

  .tab {
    min-height: 64px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 14px 18px;
    border: none;
    border-bottom: 1px solid var(--color-border);
    background: var(--color-bg);
    color: var(--color-ink);
    font: inherit;
    font-size: 16px;
    font-weight: 600;
    text-align: left;
    cursor: pointer;
  }

  .tab svg {
    flex-shrink: 0;
    color: var(--color-accent);
  }

  .tab:hover {
    background: var(--color-surface);
  }

  .tab[aria-pressed="true"] {
    background: var(--color-ink);
    color: #fff;
  }

  .tab[aria-pressed="true"] svg {
    color: #fff;
  }

  .panels {
    flex: 999 1 480px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .panel {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  /* One panel at a time once the script has run; the rest are [hidden]. With
     no script they stack, so a divider keeps them apart. */
  .panel[hidden] {
    display: none;
  }

  .who:not(.has-js) .panel + .panel {
    margin-top: 28px;
    padding-top: 28px;
    border-top: 1px solid var(--color-border);
  }

  .photo {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 7;
    object-fit: cover;
    border-radius: 12px;
  }

  .panel-title {
    font-size: 24px;
    font-weight: 600;
    color: var(--color-ink);
  }

  .panel-text {
    margin-top: 8px;
    font-size: 16px;
    line-height: 1.65;
    color: var(--color-text-muted);
  }

  .deliverables-label {
    margin-bottom: 6px;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-faint);
  }

  .items {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .items li {
    border-top: 1px solid var(--color-border);
  }

  .item summary {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    padding-block: 8px;
    font-size: 15.5px;
    line-height: 1.5;
    cursor: pointer;
    list-style: none;
  }

  .item summary::-webkit-details-marker {
    display: none;
  }

  .chev {
    flex-shrink: 0;
    color: var(--color-accent);
    transition: transform 0.15s;
  }

  .item[open] .chev {
    transform: rotate(90deg);
  }

  .item p {
    padding: 0 0 14px 23px;
    font-size: 14.5px;
    line-height: 1.6;
    color: var(--color-text-faint);
  }

  .more {
    font-size: 15.5px;
    line-height: 1.6;
    color: var(--color-text-muted);
  }

  .more a {
    color: var(--color-ink);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .more a:hover {
    color: var(--color-accent);
  }
</style>
