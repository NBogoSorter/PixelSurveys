---
// The site's contact form: full-bleed navy section, "Reach Us" sidebar, form
// in a boxed white card. Posts to /api/quote.php, which emails the client via
// the Microsoft Graph API.
//
// maxlength values below mirror the server's own limits in quote.php so the
// browser stops overlong input before a round trip - the server still enforces
// them, since nothing client-side is trustworthy.
import ServiceTypeField from "./ServiceTypeField.astro";
import { CONTACT_EMAIL, CONTACT_PHONE } from "../data/contact-info";
---

<section class="panel">
  <div class="container">
    <div class="heading">
      <h2>Let's Discuss Your Next Project</h2>
      <p>
        Fill out the form, or reach out directly to arrange a site visit or
        consultation.
      </p>
    </div>

    <div class="split">
      <div class="reach">
        <h3 class="reach-title">Reach Us</h3>
        <div class="contact">
          <div class="k">Email</div>
          <div class="v link">{CONTACT_EMAIL}</div>
        </div>
        <div class="contact">
          <div class="k">Phone</div>
          <div class="v">{CONTACT_PHONE}</div>
        </div>
      </div>

      <div class="card">
        <form
          class="form"
          action="/api/quote.php"
          method="post"
          data-quote-form
        >
          <div class="row2">
            <div class="field">
              <label for="b-name">
                Full Name <span class="req">(required)</span>
              </label>
              <input
                id="b-name"
                name="name"
                type="text"
                autocomplete="name"
                required
                maxlength="100"
              />
            </div>
            <div class="field">
              <label for="b-email">
                Email <span class="req">(required)</span>
              </label>
              <input
                id="b-email"
                name="email"
                type="email"
                autocomplete="email"
                required
                maxlength="254"
              />
            </div>
          </div>
          <div class="row2">
            <div class="field">
              <label for="b-phone">Phone</label>
              <input
                id="b-phone"
                name="phone"
                type="tel"
                autocomplete="tel"
                maxlength="40"
              />
            </div>
            <div class="field">
              <label for="b-company">Company Name</label>
              <input
                id="b-company"
                name="company"
                type="text"
                autocomplete="organization"
                maxlength="100"
              />
            </div>
          </div>
          <div class="field">
            <label id="b-service-label">Service type</label>
            {/* "services[]" (not "services") so PHP collects every checked
                box into an array instead of keeping only the last one. */}
            <ServiceTypeField id="b-service" name="services[]" />
          </div>
          <div class="field">
            <label for="b-message">Message</label>
            <p class="hint">
              Any extra details e.g. site address, rough size or a quick outline
              of the job, what the data's for, and when you need it.
            </p>
            <textarea
              id="b-message"
              name="message"
              rows="5"
              required
              minlength="10"
              maxlength="5000"></textarea>
          </div>

          {/* Honeypot: off-screen and hidden from assistive tech, so only a
              bot fills it in. quote.php fakes success when it's non-empty. */}
          <div class="hp" aria-hidden="true">
            <label for="b-website">Website</label>
            <input
              id="b-website"
              name="website"
              type="text"
              tabindex="-1"
              autocomplete="off"
            />
          </div>
          {/* Set by the script below; lets the server reject submissions made
              faster than a person could plausibly type. Empty without JS, and
              the server skips the check in that case. */}
          <input type="hidden" name="ts" value="" data-quote-ts />

          <div class="actions">
            <button type="submit" class="submit" data-quote-submit>
              Request a Quote
            </button>
            <p class="status" role="status" aria-live="polite" data-quote-status>
            </p>
          </div>
        </form>
      </div>
    </div>
  </div>
</section>

<style>
  .panel {
    background: var(--color-ink);
    color: #fff;
    padding-block: 64px;
  }

  .heading {
    margin-bottom: 34px;
  }

  .heading h2 {
    font-size: clamp(29px, 4.2vw, 38px);
    font-weight: 700;
    text-wrap: balance;
  }

  .heading p {
    margin-top: 10px;
    font-size: 16.5px;
    color: rgba(255, 255, 255, 0.75);
  }

  .split {
    display: grid;
    grid-template-columns: 260px 1fr;
    gap: 40px;
    align-items: start;
  }

  .reach-title {
    font-size: 13.5px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.6);
    margin-bottom: 18px;
  }

  .contact {
    margin-bottom: 20px;
  }

  .contact .k {
    font-size: 12.5px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.55);
  }

  .contact .v {
    margin-top: 4px;
    font-size: 16.5px;
    font-weight: 600;
  }

  .contact .v.link {
    color: var(--color-accent-green);
  }

  .card {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    padding: 32px;
  }

  .form {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .row2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  label {
    font-size: 14px;
    font-weight: 600;
    color: var(--color-ink);
  }

  .hint {
    font-size: 13.5px;
    font-weight: 400;
    color: var(--color-text-muted);
    line-height: 1.5;
    margin-top: -2px;
  }

  .req {
    font-weight: 400;
    font-size: 12.5px;
    color: var(--color-text-faint);
  }

  input,
  select,
  textarea {
    border: 1px solid var(--color-border);
    background: var(--color-bg);
    padding: 10px 12px;
    font: inherit;
    font-size: 16px;
    color: var(--color-ink);
    width: 100%;
  }

  input:focus,
  select:focus,
  textarea:focus {
    outline: none;
    border-color: var(--color-accent);
  }

  textarea {
    resize: vertical;
    min-height: 90px;
  }

  /* Off-screen rather than display:none - some bots skip hidden inputs. */
  .hp {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 20px;
  }

  .submit {
    background: var(--color-ink);
    color: #fff;
    border: none;
    font-size: 15.5px;
    font-weight: 600;
    padding: 13px 24px;
    cursor: pointer;
  }

  .submit:hover {
    background: var(--color-accent);
  }

  .submit:disabled {
    opacity: 0.6;
    cursor: progress;
  }

  /* Empty until the script writes to it, so it takes no space at rest. */
  .status {
    font-size: 15px;
    color: var(--color-text-muted);
    margin: 0;
  }

  .status:empty {
    display: none;
  }

  .status[data-state="success"] {
    color: var(--color-canopy);
    font-weight: 600;
  }

  .status[data-state="error"] {
    color: #b3432f;
    font-weight: 600;
  }

  @media (max-width: 760px) {
    .split,
    .row2 {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  // Submits via fetch so the visitor stays on the page. Without JS the form
  // still posts normally and quote.php 303-redirects to /contact/thanks/ or
  // /contact/error/, so the feature degrades rather than breaking.
  //
  // querySelectorAll, not querySelector: this component can appear more than
  // once on a page, and a single lookup would wire up only the first one.
  document
    .querySelectorAll<HTMLFormElement>("[data-quote-form]")
    .forEach((form) => {
      const ts = form.querySelector<HTMLInputElement>("[data-quote-ts]");
      const submit = form.querySelector<HTMLButtonElement>(
        "[data-quote-submit]",
      );
      const status = form.querySelector<HTMLElement>("[data-quote-status]");

      const stamp = () => {
        if (ts) ts.value = String(Math.floor(Date.now() / 1000));
      };
      stamp();

      const setStatus = (text: string, state: "success" | "error" | "") => {
        if (!status) return;
        status.textContent = text;
        status.dataset.state = state;
      };

      form.addEventListener("submit", async (event) => {
        event.preventDefault();
        if (submit) submit.disabled = true;
        setStatus("Sending…", "");

        try {
          const res = await fetch(form.action, {
            method: "POST",
            body: new FormData(form),
            headers: { Accept: "application/json" },
          });
          const data = (await res.json().catch(() => null)) as {
            ok?: boolean;
            error?: string;
          } | null;

          if (res.ok && data?.ok) {
            form.reset();
            // reset() clears the timestamp and leaves the combobox chips
            // stale, so re-stamp and let it resync from the checkboxes.
            stamp();
            form.dispatchEvent(new CustomEvent("quote-form-reset"));
            setStatus("Thanks - your request has been sent.", "success");
          } else {
            setStatus(
              data?.error ??
                "Something went wrong sending your request. Please email us directly.",
              "error",
            );
          }
        } catch {
          setStatus(
            "Couldn't reach the server. Check your connection and try again.",
            "error",
          );
        } finally {
          if (submit) submit.disabled = false;
        }
      });
    });
</script>
