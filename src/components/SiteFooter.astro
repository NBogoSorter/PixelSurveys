---
import ContactIcon from "./ContactIcon.astro";
import {
  CONTACT_EMAIL,
  CONTACT_PHONE,
  CONTACT_PHONE_DIAL,
} from "../data/contact-info";

const year = new Date().getFullYear();

// Mirrors the categories on /services/. Once the per-service detail pages
// exist, point these at them instead of the hub.
const SERVICE_LINKS = [
  { label: "Topographic Surveys", href: "/services/" },
  { label: "Volumes & Site Monitoring", href: "/services/" },
  { label: "Aerial Imagery & Mapping", href: "/services/" },
  { label: "3D Models & Point Clouds", href: "/services/" },
];

// "Company" since the client's 23 Oct 2026 footer; it was "Site".
const COMPANY_LINKS = [
  { label: "Services", href: "/services/" },
  { label: "About", href: "/about/" },
  { label: "Contact", href: "/contact/" },
];

// In the bottom bar beside the copyright, where people look for them, rather
// than in the Site column alongside the pages they came to read.
const LEGAL_LINKS = [
  { label: "Privacy Policy", href: "/privacy/" },
  { label: "Terms & Conditions", href: "/terms/" },
];
---

<footer class="footer">
  <div class="rule" aria-hidden="true"></div>
  {/* The client's 23 Oct 2026 footer: the Acknowledgement of Country first,
      then Services, Company and Contact. It replaced a brand column holding
      the name, the "across South Australia and interstate" blurb and the
      contact links - the contact links now have a column of their own. */}
  <div class="container inner">
    {/* From 768px up only. Below that the About page carries it instead,
        after its coverage areas (CoverageSection), so a phone does not end
        every page on a paragraph of small print. */}
    <p class="ack">
      Pixel Surveys acknowledges the Kaurna people as the Traditional Owners
      of the Adelaide Plains, and the Traditional Owners of all the lands on
      which we work. We recognise their continuing connection to Country,
      land and waters, and pay our respects to Elders past and present.
    </p>

    <nav class="col col-services" aria-label="Services">
      <h2 class="col-title">Services</h2>
      <ul class="links">
        {SERVICE_LINKS.map((link) => (
          <li>
            <a href={link.href}>{link.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <nav class="col col-company" aria-label="Company">
      <h2 class="col-title">Company</h2>
      <ul class="links">
        {COMPANY_LINKS.map((link) => (
          <li>
            <a href={link.href}>{link.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="col col-contact">
      <h2 class="col-title">Contact</h2>
      <ul class="links contact">
        <li>
          {/* The dial string, not the display one: stripping spaces out of
              "+61 0461 370 270" leaves the trunk 0 in, which some handsets
              refuse to dial. */}
          <a href={`tel:${CONTACT_PHONE_DIAL}`}>
            <ContactIcon name="phone" class="ico" />
            <span>{CONTACT_PHONE}</span>
          </a>
        </li>
        <li>
          <a href={`mailto:${CONTACT_EMAIL}`}>
            <ContactIcon name="email" class="ico" />
            <span>{CONTACT_EMAIL}</span>
          </a>
        </li>
      </ul>
    </div>
  </div>

  <div class="container bottom">
    {/* The name drops out on phones - see the note on .copyright-name. */}
    <p class="copyright">
      &copy; {year}<span class="copyright-name"> Pixel Surveys</span>
    </p>
    <nav aria-label="Legal">
      <ul class="legal">
        {LEGAL_LINKS.map((link) => (
          <li>
            <a href={link.href}>{link.label}</a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</footer>

<style>
  .footer {
    background: var(--color-ink);
    color: #fff;
    /* Soaks up the leftover space on a page shorter than the viewport. <body>
       is a flex column with min-height: 100vh and this is its last child, so
       the extra height lands under the copyright rather than above the footer.
       flex-grow rather than flex: 1, which would also set flex-basis to 0 and
       leave the footer's height depending on min-height: auto to clamp it. */
    flex-grow: 1;
  }

  .rule {
    height: 4px;
    background: var(--gradient-brand);
  }

  /* Four columns pushed to the edges of the container, each as wide as its
     content; the acknowledgement is the only one with a set width. */
  .inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 32px 40px;
    padding-block: 40px 32px;
  }

  .ack {
    flex: 0 1 340px;
    max-width: 340px;
    font-size: 14px;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.78);
  }

  .col {
    flex: 0 0 auto;
  }

  .contact a {
    /* inline-flex so the hit area hugs the text rather than the column. */
    display: inline-flex;
    align-items: center;
    gap: 9px;
    color: rgba(255, 255, 255, 0.9);
  }

  /* :global on the .ico part, because that <svg> comes from ContactIcon and
     therefore carries that component's scope attribute, not this one's. A
     plain `.ico` here compiles to `.ico[data-astro-cid-<this>]` and matches
     nothing - which is exactly how both icons shipped unstyled. The ancestor
     is still scoped, so this does not leak beyond this component. */
  .contact :global(.ico) {
    flex-shrink: 0;
    width: 16px;
    height: 16px;
    color: rgba(255, 255, 255, 0.55);
  }

  /* The underline belongs on the text, not dragged under the icon - .links.
     to outrank the plain .links a:hover underline further down. */
  .links.contact a:hover {
    color: #fff;
    text-decoration: none;
  }

  .contact a:hover span {
    text-decoration: underline;
  }

  .contact a:hover :global(.ico) {
    color: #fff;
  }

  .col-title {
    font-size: 13.5px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    /* 75%, up from 55%: the client's 23 Oct 2026 footer. */
    color: rgba(255, 255, 255, 0.75);
    margin-bottom: 12px;
  }

  .links {
    display: flex;
    flex-direction: column;
    gap: 8px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .links a {
    font-size: 15.5px;
    color: rgba(255, 255, 255, 0.85);
  }

  .links a:hover {
    color: #fff;
    text-decoration: underline;
  }

  .bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.16);
    padding-block: 18px 24px;
    /* Copyright left, legal links right; on a phone the links wrap under it. */
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 10px 24px;
  }

  .copyright {
    font-size: 15px;
    color: rgba(255, 255, 255, 0.7);
  }

  .legal {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 22px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .legal a {
    font-size: 15px;
    color: rgba(255, 255, 255, 0.7);
  }

  .legal a:hover {
    color: #fff;
    text-decoration: underline;
  }

  /* Phones: no acknowledgement (see the markup), Services and Company side
     by side, Contact across the full width under them - the client's phone
     design. */
  @media (max-width: 767px) {
    .inner {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 32px 24px;
    }

    .ack {
      display: none;
    }

    .col-contact {
      grid-column: 1 / -1;
    }
  }

  /* Copyright and both legal links on one line on a phone, at the client's
     request. Measured on the page in Poppins, the full set ran to 345px at
     13px before gaps - wider than the 342px a 390px phone has inside its
     gutters, and well past the 312px of a 360px one. Dropping the name from
     the copyright is what makes it fit; the logo heads every page in the
     header. Narrower than any current phone, the bar still wraps rather
     than overflowing. */
  @media (max-width: 640px) {
    .bottom {
      gap: 8px 14px;
    }

    .copyright,
    .legal a {
      font-size: 13px;
    }

    .legal {
      gap: 6px 14px;
    }

    .copyright-name {
      display: none;
    }
  }
</style>
