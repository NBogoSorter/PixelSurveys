---

<svg
  class={className}
  viewBox="1072 198 1783 2100"
  fill="none"
  stroke="currentColor"
  stroke-linecap="square"
  stroke-linejoin="bevel"
  vector-effect="non-scaling-stroke"
  aria-hidden="true"
  focusable="false"
>
  {PATHS.map((d) => <path d={d} vector-effect="non-scaling-stroke" />)}
  <path
    d={ROUND_PATH}
    stroke-linecap="round"
    stroke-linejoin="round"
    vector-effect="non-scaling-stroke"
  />
</svg>
