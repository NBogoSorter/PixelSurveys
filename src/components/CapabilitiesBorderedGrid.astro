---
// B1: plain wireframe icons in a hairline-bordered grid - each cell boxed,
// as opposed to CapabilitiesOpenGrid's whitespace-only separation.
import CapabilityIcon from "./CapabilityIcon.astro";
import { CAPABILITIES } from "../data/capabilities";
---

<section class="panel">
  <div class="container grid">
    {CAPABILITIES.map((item) => (
      <div class="card">
        <CapabilityIcon name={item.icon} class="icon" />
        <div class="body">
          <h3 class="title">{item.title}</h3>
          <p class="desc">{item.description}</p>
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  /* Full-bleed, same as CapabilitiesOpenGrid: the grey background runs edge
     to edge, the bordered grid inside stays at the normal container width. */
  .panel {
    background: var(--color-surface);
    padding-block: 30px;
  }

  .grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
    border-top: 1px solid var(--color-border);
    border-left: 1px solid var(--color-border);
  }

  .card {
    display: flex;
    gap: 16px;
    padding: 24px;
    border-right: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    background: var(--color-bg);
  }

  /* 44px, not the 24px the placeholder icons used: the client's icons
     carry far more detail (the infrastructure one alone has 30+ paths),
     and below ~44px their strokes compute to under one CSS pixel and
     render as a grey smudge. */
  .card :global(.icon) {
    width: 44px;
    height: 44px;
    margin-top: 3px;
    /* Matches .title beside it - and it's the colour the client drew these
       icons in (#0C538D is --color-ink). */
    color: var(--color-ink);
    flex-shrink: 0;
  }

  /* This icon's frame is the most tightly filled of the six, but its stroke
     ratio is the thinnest (1:44 against ~1:33), so at 44px it renders a 1.0px
     line and reads faint rather than small. Scaled with a transform, not
     width/height, so its layout box stays 44px and the text in every card
     still starts on the same line. */
  .card :global(.icon[data-icon="infrastructure"]) {
    transform: scale(1.3);
  }

  .body {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .title {
    font-size: 16px;
    font-weight: 600;
    color: var(--color-ink);
  }

  .desc {
    font-size: 13px;
    line-height: 1.6;
    color: var(--color-text-muted);
  }

  @media (max-width: 720px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
