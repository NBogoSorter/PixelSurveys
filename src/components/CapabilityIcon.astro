---
// Client-supplied icons (media/icons/), inlined rather than loaded as files so
// they inherit their colour from CSS.
//
// Changed from the originals:
//   - the hard-coded #0C538D stroke became currentColor, so one icon works on
//     white, on the surface tint and on the navy panel
//   - Inkscape wrappers (<defs>, ids, xml:space, mm width/height) stripped, and
//     the per-path style="" declarations became plain attributes
//   - the five Inkscape icons were drawn on non-square canvases of five
//     different aspect ratios, which would render at visibly different sizes in
//     one grid. Each viewBox is padded out to a square centred on the original
//     artwork - the drawing is untouched, only the frame around it.
// Geometry and stroke weights are exactly as supplied.
import type { CapabilityIconName } from "../data/capabilities";

interface Props {
  name: CapabilityIconName;
  class?: string;
}

const { name, class: className } = Astro.props;
---

