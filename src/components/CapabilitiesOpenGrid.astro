---
// "Combined draft": B1's plain wireframe icons, arranged in B2's
// open-whitespace grid - no card borders, two columns separated by gap alone.
import CapabilityIcon from "./CapabilityIcon.astro";
import { CAPABILITIES } from "../data/capabilities";
---

<section class="panel">
  <div class="container grid">
    {CAPABILITIES.map((item) => (
      <div class="card">
        <CapabilityIcon name={item.icon} class="icon" />
        <div class="body">
          <h3 class="title">{item.title}</h3>
          <p class="desc">{item.description}</p>
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  /* Full-bleed: the tinted background runs edge to edge, the card grid
     inside stays at the normal container width via the global .container. */
  .panel {
    background: var(--color-surface);
    padding-block: 30px;
  }

  .grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 26px 30px;
  }

  .card {
    display: flex;
    gap: 16px;
  }

  .card :global(.icon) {
    width: 24px;
    height: 24px;
    margin-top: 3px;
    color: var(--color-accent);
    flex-shrink: 0;
  }

  .body {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .title {
    font-size: 16px;
    font-weight: 600;
    color: var(--color-ink);
  }

  .desc {
    font-size: 13px;
    line-height: 1.6;
    color: var(--color-text-muted);
  }

  @media (max-width: 720px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
