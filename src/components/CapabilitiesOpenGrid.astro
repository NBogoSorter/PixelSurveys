---
// "Combined draft": B1's plain wireframe icons, arranged in B2's
// open-whitespace grid - no card borders, two columns separated by gap alone.
import CapabilityIcon from "./CapabilityIcon.astro";
import { CAPABILITIES } from "../data/capabilities";
---

<section class="panel">
  <div class="container grid">
    {CAPABILITIES.map((item) => (
      <div class="card">
        <CapabilityIcon name={item.icon} class="icon" />
        <div class="body">
          <h3 class="title">{item.title}</h3>
          <p class="desc">{item.description}</p>
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  /* Full-bleed: the tinted background runs edge to edge, the card grid
     inside stays at the normal container width via the global .container. */
  .panel {
    background: var(--color-surface);
    padding-block: 30px;
  }

  .grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 26px 30px;
  }

  .card {
    display: flex;
    gap: 16px;
  }

  /* 44px, not the 24px the placeholder icons used: the client's icons
     carry far more detail (the infrastructure one alone has 30+ paths),
     and below ~44px their strokes compute to under one CSS pixel and
     render as a grey smudge. */
  .card :global(.icon) {
    width: 44px;
    height: 44px;
    margin-top: 3px;
    /* Matches .title beside it - and it's the colour the client drew these
       icons in (#0C538D is --color-ink). */
    color: var(--color-ink);
    flex-shrink: 0;
  }

  /* This icon's frame is the most tightly filled of the six, but its stroke
     ratio is the thinnest (1:44 against ~1:33), so at 44px it renders a 1.0px
     line and reads faint rather than small. Scaled with a transform, not
     width/height, so its layout box stays 44px and the text in every card
     still starts on the same line. */
  .card :global(.icon[data-icon="infrastructure"]) {
    transform: scale(1.3);
  }

  .body {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  /* "Generous" text scale - see the type-size comparison. Only this grid
     uses it; CapabilitiesBorderedGrid (Draft B) keeps the original sizes so
     the A/B comparison stays about the grid style. */
  .title {
    font-size: 18px;
    font-weight: 600;
    color: var(--color-ink);
  }

  .desc {
    font-size: 15px;
    line-height: 1.6;
    color: var(--color-text-muted);
  }

  @media (max-width: 720px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
