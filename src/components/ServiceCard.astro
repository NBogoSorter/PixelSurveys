---
// Homepage service card - design A3 from the services-section exploration:
// open cards (no border or panel), a rounded image, and a list whose items are
// separated by rules rather than carrying bullets.
//
// The rules are the list's structure here, so they use the site's standard
// border colour rather than a fainter hairline - #eef4f4 disappears at this
// size, and on the grey band behind these cards so did #e4eded.
import { Image } from "astro:assets";
import type { Service } from "../data/services";

interface Props {
  service: Service;
}

const { service } = Astro.props;

// A service can carry a separate homepage photo. Where it does, the alt text
// comes from homeImageAlt rather than falling back to imageAlt - that one
// describes the services page photo, which is a different picture.
const photo = service.homeImage ?? service.image;
const photoAlt = service.homeImage
  ? (service.homeImageAlt ?? "")
  : (service.imageAlt ?? "");
---

<article class="card">
  {/* The photo links to the services page like the title and "Learn more"
      below it - the client's call, 23 Oct 2026. It is a third link to the
      same place, so it is hidden from assistive tech and skipped by the Tab
      key: keyboard and screen reader users already have the other two. */}
  <a href={service.href} class="photo-link" tabindex="-1" aria-hidden="true">
    {photo ? (
      <Image
        src={photo}
        alt={photoAlt}
        width={640}
        widths={[320, 480, 640]}
        sizes="(max-width: 520px) 100vw, (max-width: 860px) 50vw, 280px"
        class="band"
      />
    ) : (
      <div
        class="band band-placeholder"
        style={`--band-from: ${service.bandFrom}; --band-to: ${service.bandTo};`}
      />
    )}
  </a>

  {/* Same destination as "Learn more" below, so the two can't disagree. */}
  <h3 class="title">
    <a href={service.href} class="title-link">{service.title}</a>
  </h3>

  <ul class="list">
    {service.subServices.map((sub) => (
      <li>{sub.title}</li>
    ))}
  </ul>

  <a href={service.href} class="learn">
    <span>Learn More</span>
    <svg
      viewBox="0 0 24 24"
      width="16"
      height="16"
      fill="none"
      stroke="currentColor"
      stroke-width="2.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M5 12h14" />
      <path d="M13 6l6 6-6 6" />
    </svg>
    {/* "Learn more" four times over is a poor set of link names on its own,
        so each one names its service for anyone listing the page's links. */}
    <span class="visually-hidden"> about {service.title}</span>
  </a>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .photo-link {
    display: block;
  }

  .band {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 12px;
  }

  .band-placeholder {
    background: linear-gradient(135deg, var(--band-from), var(--band-to));
  }

  .title {
    font-size: 22px;
    font-weight: 600;
    color: var(--color-ink);
    line-height: 1.3;
    text-wrap: balance;
  }

  /* The title as a link, signalled only by the colour easing from navy to
     teal - no underline, at the client's request. Focus gets the same fade,
     on top of the site-wide focus outline, so keyboard users see it too. */
  .title-link {
    color: inherit;
    transition: color 0.2s ease;
  }

  .title-link:hover,
  .title-link:focus-visible,
  .title-link:active {
    color: var(--color-accent);
  }

  .list {
    list-style: none;
    margin: 0;
    padding: 0;
    flex: 1;
  }

  .list li {
    font-size: 16px;
    line-height: 1.45;
    color: var(--color-text-muted);
    padding-block: 9px;
    border-top: 1px solid var(--color-border);
  }

  /* Navy text with a teal arrow, at body size - the client's 23 Oct 2026
     design, so the link reads with the rest of the card rather than as a
     second accent colour. */
  .learn {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 16px;
    font-weight: 600;
    color: var(--color-ink);
  }

  .learn svg {
    color: var(--color-accent);
  }

  .learn:hover {
    text-decoration: underline;
  }

  .learn:hover svg {
    transform: translateX(3px);
  }

  .learn svg {
    transition: transform 0.15s;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>
