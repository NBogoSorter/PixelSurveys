---
import { SERVICES } from "../data/services";
import ServiceCard from "./ServiceCard.astro";

interface Props {
  /** Hide the "View All Services" button, e.g. on the services page itself. */
  showCta?: boolean;
}

const { showCta = true } = Astro.props;
---

<section class="section">
  <div class="container wide">
    <h2 class="heading">
      <a href="/services/" class="heading-link">Our Services</a>
    </h2>

    <div class="grid">
      {SERVICES.map((service) => (
        <ServiceCard service={service} />
      ))}
    </div>

    {showCta && (
      <div class="cta">
        <a href="/services/" class="button cta-button">
          View All Services
        </a>
      </div>
    )}
  </div>
</section>

<style>
  /* A full-width grey band, from the client's "consistent colours and
     layout" design on 23 Oct 2026 - the same grey as the FAQ band further
     down. The gap above is the usual section gap; inside, 80px on desktop,
     tightening on phones. The section after it owns its own top space. */
  .section {
    margin-top: var(--space-section);
    padding-block: clamp(56px, 6vw, 80px);
    background: var(--color-band);
  }

  .heading {
    font-size: clamp(29px, 3.6vw, 36px);
    font-weight: 700;
    color: var(--color-ink);
    margin-bottom: var(--space-heading);
    text-wrap: balance;
  }

  /* Matches the service titles' links in ServiceCard: no underline, just the
     colour easing from navy to teal. */
  .heading-link {
    color: inherit;
    transition: color 0.2s ease;
  }

  .heading-link:hover,
  .heading-link:focus-visible,
  .heading-link:active {
    color: var(--color-accent);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    /* Wider than the old 20px: with the card borders gone, the gap is the
       only thing separating one service from the next. */
    gap: 28px;
  }

  .cta {
    display: flex;
    justify-content: flex-end;
    margin-top: 28px;
  }

  /* Back to 1400px, at the client's request on 23 Oct 2026: the 1200px column
     from their consistent-layout design made the cards about 267px and the
     longer names wrap to two lines, and they wanted the services larger and
     more spread out as before. The longest name ("Volumes & Site
     Monitoring") needs about 292px at 22px; 1400px gives each card 317px.
     This is the one section wider than the rest of the page. Two columns
     below 1300px, where four would squeeze the names again. */
  .wide {
    max-width: 1400px;
  }

  @media (max-width: 1300px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 520px) {
    .grid {
      grid-template-columns: 1fr;
    }

    .cta-button {
      flex: 1;
      text-align: center;
    }
  }
</style>
