---
import { SERVICES } from "../data/services";
import ServiceCard from "./ServiceCard.astro";

interface Props {
  /** Hide the "View All Services" button, e.g. on the services page itself. */
  showCta?: boolean;
}

const { showCta = true } = Astro.props;
---

<section class="section">
  <div class="container wide">
    <h2 class="heading">
      <a href="/services/" class="heading-link">Our Services</a>
    </h2>

    <div class="grid">
      {SERVICES.map((service) => (
        <ServiceCard service={service} />
      ))}
    </div>

    {showCta && (
      <div class="cta">
        <a href="/services/" class="button cta-button">
          View All Services
        </a>
      </div>
    )}
  </div>
</section>

<style>
  /* Top only; the section after this owns the gap below it. */
  .section {
    padding-top: var(--space-section);
  }

  .heading {
    font-size: clamp(29px, 3.6vw, 36px);
    font-weight: 700;
    color: var(--color-ink);
    margin-bottom: var(--space-heading);
    text-wrap: balance;
  }

  /* Matches the service titles' links in ServiceCard: no underline, just the
     colour easing from navy to teal. */
  .heading-link {
    color: inherit;
    transition: color 0.2s ease;
  }

  .heading-link:hover,
  .heading-link:focus-visible,
  .heading-link:active {
    color: var(--color-accent);
  }

  /* Wider than the page's usual 1200px column, so the four category names sit
     on one line each. The longest ("Volumes & Site Monitoring", 25 characters)
     needs about 292px at 22px; a 1400px container gives each card 317px.
     NOTE: this makes the section wider than every other section on the page -
     the hero, capabilities, FAQ and contact all sit in the 1200px column. */
  .wide {
    max-width: 1400px;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    /* Wider than the old 20px: with the card borders gone, the gap is the
       only thing separating one service from the next. */
    gap: 28px;
  }

  .cta {
    display: flex;
    justify-content: flex-end;
    margin-top: 28px;
  }

  /* Drops to two columns at 1300px, not the old 860px: between those widths
     four columns give each card under 292px and the titles wrap again, which
     is the thing this layout is trying to avoid. Two columns are far wider
     than needed, so nothing wraps from here up. */
  @media (max-width: 1300px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 520px) {
    .grid {
      grid-template-columns: 1fr;
    }

    .cta-button {
      flex: 1;
      text-align: center;
    }
  }
</style>
