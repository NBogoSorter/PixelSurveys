---
// SERVICE_TYPES, not SERVICES: quote.php validates submitted values against
// the service-type list, so the fuller category names used on the services
// page would be silently dropped.
import { SERVICE_TYPES } from "../data/service-types";
---

<form class="form" action="/api/quote.php" method="post" data-quote-form>
  <div class="row">
    <div class="field">
      <label for="quote-name">Name</label>
      <input
        id="quote-name"
        name="name"
        type="text"
        autocomplete="name"
        required
        maxlength="100"
      />
    </div>
    <div class="field">
      <label for="quote-email">Email</label>
      <input
        id="quote-email"
        name="email"
        type="email"
        autocomplete="email"
        required
        maxlength="254"
      />
    </div>
  </div>

  <div class="row">
    <div class="field">
      <label for="quote-phone">
        Phone <span class="optional">(optional)</span>
      </label>
      <input
        id="quote-phone"
        name="phone"
        type="tel"
        autocomplete="tel"
        maxlength="40"
      />
    </div>
    <div class="field">
      <label for="quote-service">Service</label>
      {/* "services[]" to match what quote.php reads - a single-select just
          posts a one-element array. See ContactFormB, the main form. */}
      <select id="quote-service" name="services[]">
        <option value="">Not sure yet</option>
        {SERVICE_TYPES.map((s) => (
          <option value={s.title}>{s.title}</option>
        ))}
      </select>
    </div>
  </div>

  <div class="field">
    <label for="quote-message">Project details</label>
    <textarea
      id="quote-message"
      name="message"
      rows="6"
      required
      minlength="10"
      maxlength="5000"
      placeholder="Site location, approximate area, deliverables you need, timeframe"
    ></textarea>
  </div>

  {/* Honeypot: hidden from people, often filled in by bots. */}
  <div class="hp" aria-hidden="true">
    <label for="quote-website">Website</label>
    <input
      id="quote-website"
      name="website"
      type="text"
      tabindex="-1"
      autocomplete="off"
    />
  </div>
  <input type="hidden" name="ts" value="" data-quote-ts />

  <div class="actions">
    <button type="submit" class="submit" data-quote-submit>
      Request a Quote
    </button>
    <p class="status" role="status" aria-live="polite" data-quote-status></p>
  </div>
</form>

<style>
  .form {
    display: flex;
    flex-direction: column;
    gap: 18px;
    max-width: 720px;
  }

  .row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  label {
    font-size: 13px;
    font-weight: 600;
    color: var(--color-ink);
  }

  .optional {
    font-weight: 400;
    color: var(--color-text-muted);
  }

  input,
  select,
  textarea {
    font: inherit;
    font-size: 15px;
    color: var(--color-ink);
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 0;
    padding: 11px 12px;
    width: 100%;
  }

  input:focus,
  select:focus,
  textarea:focus {
    border-color: var(--color-accent);
  }

  textarea {
    resize: vertical;
  }

  .hp {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 20px;
  }

  .submit {
    font: inherit;
    font-size: 14px;
    font-weight: 600;
    color: #fff;
    background: var(--color-ink);
    border: none;
    padding: 13px 26px;
    cursor: pointer;
  }

  .submit:hover {
    background: var(--color-ink-soft);
  }

  .submit:disabled {
    opacity: 0.6;
    cursor: progress;
  }

  .status {
    font-size: 14px;
    color: var(--color-text-muted);
  }

  .status[data-state="success"] {
    color: var(--color-accent);
    font-weight: 600;
  }

  .status[data-state="error"] {
    color: #b3432f;
    font-weight: 600;
  }

  @media (max-width: 600px) {
    .row {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>("[data-quote-form]");

  if (form) {
    const ts = form.querySelector<HTMLInputElement>("[data-quote-ts]");
    const submit = form.querySelector<HTMLButtonElement>("[data-quote-submit]");
    const status = form.querySelector<HTMLElement>("[data-quote-status]");

    // Lets the server reject submissions made faster than a person could type.
    if (ts) ts.value = String(Math.floor(Date.now() / 1000));

    const setStatus = (text: string, state: "success" | "error" | "") => {
      if (!status) return;
      status.textContent = text;
      status.dataset.state = state;
    };

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (submit) submit.disabled = true;
      setStatus("Sending…", "");

      try {
        const res = await fetch(form.action, {
          method: "POST",
          body: new FormData(form),
          headers: { Accept: "application/json" },
        });
        const data = (await res.json().catch(() => null)) as {
          ok?: boolean;
          error?: string;
        } | null;

        if (res.ok && data?.ok) {
          form.reset();
          if (ts) ts.value = String(Math.floor(Date.now() / 1000));
          setStatus("Thanks - your request has been sent.", "success");
        } else {
          setStatus(
            data?.error ??
              "Something went wrong sending your request. Please email us directly.",
            "error",
          );
        }
      } catch {
        setStatus(
          "Couldn't reach the server. Check your connection and try again.",
          "error",
        );
      } finally {
        if (submit) submit.disabled = false;
      }
    });
  }
</script>
