---
import type { TrustIconName } from "../data/trust-points";

interface Props {
  name: TrustIconName;
  class?: string;
}

const { name, class: className } = Astro.props;
---

{name === "licensed" && (
  <svg
    class={className}
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.6"
    aria-hidden="true"
  >
    <rect x="3" y="5" width="14" height="11" rx="1" />
    <path d="M6 9h5M6 12h3" />
    <circle cx="17" cy="17" r="4" />
    <path d="M15.3 17.1 16.5 18.3 18.7 15.9" />
  </svg>
)}
{name === "insured" && (
  <svg
    class={className}
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.6"
    aria-hidden="true"
  >
    <path d="M12 3l7 3v6c0 5-3.5 7.5-7 9-3.5-1.5-7-4-7-9V6l7-3z" />
    <path d="M9 12l2 2 4-4" />
  </svg>
)}
{name === "compliant" && (
  <svg
    class={className}
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.6"
    aria-hidden="true"
  >
    <circle cx="6" cy="6" r="2" />
    <circle cx="18" cy="6" r="2" />
    <circle cx="6" cy="18" r="2" />
    <circle cx="18" cy="18" r="2" />
    <path d="M6 6l5 5M18 6l-5 5M6 18l5-5M18 18l-5-5" />
    <rect x="10" y="10" width="4" height="4" rx="0.5" />
  </svg>
)}
{name === "accurate" && (
  <svg
    class={className}
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.6"
    aria-hidden="true"
  >
    <rect x="4" y="4" width="16" height="16" />
    <path d="M12 4v16M4 12h16" />
  </svg>
)}
