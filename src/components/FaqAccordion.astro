---
// Design B from the FAQ layout exploration: accordion, one question open at
// a time via native <details>/<summary>. Full-bleed panel, same pattern as
// CapabilitiesOpenGrid/TrustBar - background spans the page, content stays
// at the normal container width.
import { FAQ_ITEMS } from "../data/faq";
---

<section class="panel">
  <div class="container">
    
    <h2 class="heading">What clients ask before the first flight</h2>

    <div class="list">
      {FAQ_ITEMS.map((item, index) => (
        <details class="row" open={index === 0}>
          <summary class="header">
            <span class="q">{item.question}</span>
            <span class="chev" aria-hidden="true">
              &#9656;
            </span>
          </summary>
          <p class="a">{item.answer}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .panel {
    background: var(--color-surface);
    padding-block: 60px;
  }

  .tab {
    width: 34px;
    height: 6px;
    background: var(--color-accent);
    margin-bottom: 16px;
  }

  .heading {
    font-size: clamp(24px, 3vw, 30px);
    font-weight: 700;
    color: var(--color-ink);
    margin-bottom: 30px;
    text-wrap: balance;
  }

  .list {
    display: flex;
    flex-direction: column;
    max-width: 760px;
  }

  .row {
    border-top: 1px solid var(--color-border);
  }

  .row:last-child {
    border-bottom: 1px solid var(--color-border);
  }

  .header {
    display: flex;
    align-items: center;
    gap: 14px;
    padding-block: 18px;
    cursor: pointer;
    list-style: none;
  }

  .header::-webkit-details-marker {
    display: none;
  }

  .q {
    flex: 1;
    font-size: 16px;
    font-weight: 600;
    color: var(--color-ink);
  }

  .chev {
    flex-shrink: 0;
    color: var(--color-text-muted);
    font-size: 13px;
    transition: transform 0.15s;
  }

  .row[open] .chev {
    transform: rotate(90deg);
  }

  .a {
    padding-bottom: 20px;
    max-width: 62ch;
    font-size: 14px;
    line-height: 1.6;
    color: var(--color-text-muted);
  }
</style>
