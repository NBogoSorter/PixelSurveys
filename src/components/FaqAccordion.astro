---
// Design B from the FAQ layout exploration: accordion built on native
// <details>/<summary>. Full-bleed panel, same pattern as
// CapabilitiesOpenGrid/TrustBar - background spans the page, content stays
// at the normal container width.
//
// Every row starts closed, so the section opens as a clean list of questions
// with no answer previewed. Opening one does not close the others: that would
// need name="faq" on the <details>, and nothing has asked for it.
//
// Only the first VISIBLE questions show; the rest sit behind "Show more
// questions". The client's concern was the height of the section with nine
// questions in it, and this was the option they picked.
import { FAQ_ITEMS } from "../data/faq";

/** How many questions show before the rest are collapsed. */
const VISIBLE = 4;
---

<section class="panel" data-faq>
  <div class="container">
    <h2 class="heading">Common Questions</h2>

    <div class="list">
      {FAQ_ITEMS.map((item) => (
        <details class="row" data-faq-row>
          <summary class="header">
            <span class="q">{item.question}</span>
            <span class="chev" aria-hidden="true">
              &#9656;
            </span>
          </summary>
          <div class="a">
            {(Array.isArray(item.answer) ? item.answer : [item.answer]).map(
              (paragraph) => <p>{paragraph}</p>,
            )}
          </div>
        </details>
      ))}
    </div>

    {FAQ_ITEMS.length > VISIBLE && (
      <div class="more-wrap">
        <button type="button" class="more" aria-expanded="false" data-faq-more>
          <span data-faq-more-label>Show more questions</span>
          <svg
            class="more-icon"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.4"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M6 9l6 6l6 -6" />
          </svg>
        </button>
      </div>
    )}
  </div>
</section>

<script>
  // Progressive enhancement, the same shape as the header's menu. Every
  // question ships in the markup and the button ships hidden; adding .has-js
  // is what collapses the list. Without JavaScript nobody loses an answer -
  // they just get all nine, which is what the section did before.
  const VISIBLE = 4;

  const section = document.querySelector<HTMLElement>("[data-faq]");
  const rows = section
    ? Array.from(section.querySelectorAll<HTMLDetailsElement>("[data-faq-row]"))
    : [];
  const button = section?.querySelector<HTMLButtonElement>("[data-faq-more]");
  const label = section?.querySelector<HTMLElement>("[data-faq-more-label]");

  if (section && button && label && rows.length > VISIBLE) {
    section.classList.add("has-js");

    let expanded = false;

    const apply = () => {
      rows.forEach((row, index) => {
        row.classList.toggle("is-hidden", !expanded && index >= VISIBLE);
      });
      button.setAttribute("aria-expanded", String(expanded));
      label.textContent = expanded ? "Show less" : "Show more questions";
    };

    apply();

    button.addEventListener("click", () => {
      expanded = !expanded;
      // Collapsing closes whatever was opened down there. Otherwise the next
      // expand reveals an answer the visitor did not just ask for.
      if (!expanded) {
        rows.slice(VISIBLE).forEach((row) => row.removeAttribute("open"));
      }
      apply();
    });
  }
</script>

<style>
  .panel {
    background: var(--color-surface);
    padding-block: var(--space-band);
  }

  .heading {
    font-size: clamp(29px, 3.6vw, 36px);
    font-weight: 700;
    color: var(--color-ink);
    margin-bottom: var(--space-heading);
    text-wrap: balance;
  }

  .list {
    display: flex;
    flex-direction: column;
    max-width: 760px;
    /* The closing rule belongs to the list, not to .row:last-child. Hiding the
       tail of the list would otherwise leave the last VISIBLE row with no
       bottom edge, because :last-child still means the ninth row. */
    border-bottom: 1px solid var(--color-border);
  }

  .row {
    border-top: 1px solid var(--color-border);
  }

  /* Only ever set while the script is running - see .has-js. */
  .row.is-hidden {
    display: none;
  }

  .header {
    display: flex;
    align-items: center;
    gap: 14px;
    padding-block: 18px;
    cursor: pointer;
    list-style: none;
  }

  .header::-webkit-details-marker {
    display: none;
  }

  .q {
    flex: 1;
    font-size: 18px;
    font-weight: 600;
    color: var(--color-ink);
  }

  .chev {
    flex-shrink: 0;
    color: var(--color-text-muted);
    font-size: 15px;
    transition: transform 0.15s;
  }

  .row[open] .chev {
    transform: rotate(90deg);
  }

  .a {
    padding-bottom: 20px;
    max-width: 62ch;
    font-size: 16px;
    line-height: 1.6;
    color: var(--color-text-muted);
  }

  /* Longer answers arrive as several paragraphs. Space between them, and
     none after the last, so the closing gap stays the .a padding above. */
  .a p + p {
    margin-top: 14px;
  }

  /* Hidden until the script takes over, so a visitor without JavaScript is
     never offered a button that reveals nothing. */
  .more-wrap {
    display: none;
    justify-content: center;
    max-width: 760px;
    margin-top: 22px;
  }

  .has-js .more-wrap {
    display: flex;
  }

  /* No underline, at the client's request - the chevron carries the
     affordance. */
  .more {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 2px;
    background: none;
    border: none;
    color: var(--color-ink);
    cursor: pointer;
    font-family: inherit;
    font-size: 16px;
    font-weight: 600;
  }

  .more:hover {
    color: var(--color-accent);
  }

  .more-icon {
    flex-shrink: 0;
    width: 17px;
    height: 17px;
    color: var(--color-accent);
    transition: transform 0.15s;
  }

  .more[aria-expanded="true"] .more-icon {
    transform: rotate(180deg);
  }
</style>
