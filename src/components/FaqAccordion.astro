---
// Design B from the FAQ layout exploration: accordion built on native
// <details>/<summary>. Full-bleed panel, same pattern as
// CapabilitiesOpenGrid/TrustBar - background spans the page, content stays
// at the normal container width.
//
// Every row starts closed, so the section opens as a clean list of questions
// with no answer previewed. Opening one does not close the others: that would
// need name="faq" on the <details>, and nothing has asked for it.
import { FAQ_ITEMS } from "../data/faq";
---

<section class="panel">
  <div class="container">
    
    <h2 class="heading">FAQs</h2>

    <div class="list">
      {FAQ_ITEMS.map((item) => (
        <details class="row">
          <summary class="header">
            <span class="q">{item.question}</span>
            <span class="chev" aria-hidden="true">
              &#9656;
            </span>
          </summary>
          <div class="a">
            {(Array.isArray(item.answer) ? item.answer : [item.answer]).map(
              (paragraph) => <p>{paragraph}</p>,
            )}
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .panel {
    background: var(--color-surface);
    padding-block: 60px;
  }

  .tab {
    width: 34px;
    height: 6px;
    background: var(--color-accent);
    margin-bottom: 16px;
  }

  .heading {
    font-size: clamp(29px, 3.6vw, 36px);
    font-weight: 700;
    color: var(--color-ink);
    margin-bottom: 30px;
    text-wrap: balance;
  }

  .list {
    display: flex;
    flex-direction: column;
    max-width: 760px;
  }

  .row {
    border-top: 1px solid var(--color-border);
  }

  .row:last-child {
    border-bottom: 1px solid var(--color-border);
  }

  .header {
    display: flex;
    align-items: center;
    gap: 14px;
    padding-block: 18px;
    cursor: pointer;
    list-style: none;
  }

  .header::-webkit-details-marker {
    display: none;
  }

  .q {
    flex: 1;
    font-size: 18px;
    font-weight: 600;
    color: var(--color-ink);
  }

  .chev {
    flex-shrink: 0;
    color: var(--color-text-muted);
    font-size: 15px;
    transition: transform 0.15s;
  }

  .row[open] .chev {
    transform: rotate(90deg);
  }

  .a {
    padding-bottom: 20px;
    max-width: 62ch;
    font-size: 16px;
    line-height: 1.6;
    color: var(--color-text-muted);
  }

  /* Longer answers arrive as several paragraphs. Space between them, and
     none after the last, so the closing gap stays the .a padding above. */
  .a p + p {
    margin-top: 14px;
  }
</style>
