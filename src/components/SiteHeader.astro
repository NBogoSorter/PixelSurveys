---
import { Image } from "astro:assets";
import logo from "../assets/logo.png";

const NAV_LINKS = [
  { label: "Home", href: "/" },
  { label: "Services", href: "/services/" },
  { label: "About", href: "/about/" },
  // Styled as the header's call to action rather than a plain link. It stays
  // inside the nav list because that is what it is - navigation - and the
  // separate "Get a Free Quote" button that used to sit beside it pointed at
  // this same page, so the two were doing one job.
  { label: "Contact", href: "/contact/", cta: true },
];

const currentPath = Astro.url.pathname;
---

<header class="header">
  <div class="container inner">
    <a href="/" class="logo" aria-label="Pixel Surveys home">
      <Image
        src={logo}
        alt="Pixel Surveys"
        height={40}
        densities={[1, 2]}
        loading="eager"
        class="logo-image"
      />
    </a>

    <nav aria-label="Main">
      <ul class="nav-list">
        {NAV_LINKS.map((link) => (
          <li>
            <a
              href={link.href}
              class:list={["nav-link", link.cta && "nav-cta"]}
              aria-current={currentPath === link.href ? "page" : undefined}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .header {
    border-bottom: 3px solid var(--color-accent);
    background: var(--color-bg);
    position: sticky;
    top: 0;
    z-index: 50;
  }

  .inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-block: 16px;
  }

  .logo {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .logo-image {
    height: 40px;
    width: auto;
  }

  .nav-list {
    display: flex;
    flex-wrap: wrap;
    /* A button sitting among text links needs the row centred on it. */
    align-items: center;
    gap: 8px 28px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-link {
    font-size: 15px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-ink);
  }

  .nav-link:hover,
  .nav-link[aria-current="page"] {
    color: var(--color-accent);
  }

  /* Contact, carrying the styling the removed quote button had. Uppercase like
     its siblings rather than the title case that button used, since it sits in
     the same row as them. */
  .nav-cta {
    background: var(--color-ink);
    color: #fff;
    padding: 10px 18px;
    white-space: nowrap;
  }

  .nav-cta:hover,
  .nav-cta[aria-current="page"] {
    background: var(--color-accent);
    /* Overrides .nav-link's hover colour, which would otherwise turn the
       label teal on a teal fill. */
    color: #fff;
  }

  @media (max-width: 640px) {
    .inner {
      flex-direction: column;
      align-items: flex-start;
      gap: 12px;
      padding-block: 14px;
    }

    .nav-list {
      gap: 8px 20px;
    }

    .logo-image {
      height: 32px;
    }

    /* The header stacks tall on phones; sticky would eat most of the
       viewport, so it scrolls away instead. */
    .header {
      position: static;
    }
  }
</style>
