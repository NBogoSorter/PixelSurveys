---
import { Image } from "astro:assets";
import logo from "../assets/logo.png";

const NAV_LINKS = [
  { label: "Home", href: "/" },
  { label: "Services", href: "/services/" },
  { label: "About", href: "/about/" },
  { label: "Contact", href: "/contact/" },
];

const currentPath = Astro.url.pathname;
---

<header class="header">
  <div class="container inner">
    <a href="/" class="logo" aria-label="Pixel Surveys home">
      <Image
        src={logo}
        alt="Pixel Surveys"
        height={40}
        densities={[1, 2]}
        loading="eager"
        class="logo-image"
      />
    </a>

    <div class="right">
      <nav aria-label="Main">
        <ul class="nav-list">
          {NAV_LINKS.map((link) => (
            <li>
              <a
                href={link.href}
                class="nav-link"
                aria-current={currentPath === link.href ? "page" : undefined}
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
      <a href="/contact/" class="quote">Get a Free Quote</a>
    </div>
  </div>
</header>

<style>
  .header {
    border-bottom: 3px solid var(--color-accent);
    background: var(--color-bg);
    position: sticky;
    top: 0;
    z-index: 50;
  }

  .right {
    display: flex;
    align-items: center;
    gap: 32px;
  }

  .quote {
    flex-shrink: 0;
    background: var(--color-ink);
    color: #fff;
    font-size: 12.5px;
    font-weight: 600;
    letter-spacing: 0.04em;
    padding: 11px 20px;
    white-space: nowrap;
  }

  .quote:hover {
    background: var(--color-accent);
  }

  .inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-block: 16px;
  }

  .logo {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .logo-image {
    height: 40px;
    width: auto;
  }

  .nav-list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 32px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-link {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-ink);
  }

  .nav-link:hover,
  .nav-link[aria-current="page"] {
    color: var(--color-accent);
  }

  @media (max-width: 860px) {
    .right {
      gap: 20px;
    }
  }

  @media (max-width: 640px) {
    .inner {
      flex-direction: column;
      align-items: flex-start;
      gap: 12px;
      padding-block: 14px;
    }

    .right {
      flex-direction: column;
      align-items: flex-start;
      gap: 12px;
      width: 100%;
    }

    .nav-list {
      gap: 8px 20px;
    }

    .logo-image {
      height: 32px;
    }

    /* The header stacks tall on phones; sticky would eat most of the
       viewport, so it scrolls away instead. */
    .header {
      position: static;
    }
  }
</style>
