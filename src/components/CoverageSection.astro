        <g fill="none" stroke="#FFFFFF" stroke-width="6" aria-hidden="true">
          <circle cx="596.8" cy="622.5" r="64" opacity="0.9"></circle>
          <circle cx="596.8" cy="622.5" r="105" opacity="0.6"></circle>
          <circle cx="596.8" cy="622.5" r="146" opacity="0.35"></circle>
          <circle cx="810.3" cy="612.5" r="42" opacity="0.9"></circle>
          <circle cx="810.3" cy="612.5" r="74" opacity="0.6"></circle>
          <circle cx="810.3" cy="612.5" r="106" opacity="0.35"></circle>
        </g>
        <g transform="translate(596.8 622.5)">
          <path
            d="M0,0 C-7,-16 -26,-30 -26,-52 A26,26 0 1 1 26,-52 C26,-30 7,-16 0,0Z"
            fill="#A3A8AE"></path>
          <circle cx="0" cy="-52" r="10" fill="#FFFFFF"></circle>
        </g>
        <g transform="translate(810.3 612.5) scale(0.65)">
          <path
            d="M0,0 C-7,-16 -26,-30 -26,-52 A26,26 0 1 1 26,-52 C26,-30 7,-16 0,0Z"
            fill="#A3A8AE"></path>
          <circle cx="0" cy="-52" r="10" fill="#FFFFFF"></circle>
        </g>
      </svg>
    </div>
  </div>

  <ul class="areas">
    {AREAS.map((area) => (
      <li class="area">
        <svg
          class="pin"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21z" />
          <circle cx="12" cy="9.5" r="2.5" />
        </svg>
        <div class="area-body">
          <h3 class="area-name">{area.name}</h3>
          <p class="area-desc">{area.description}</p>
          {area.regions && (
            <ul class="regions" aria-label={`Regions covered from ${area.name}`}>
              {area.regions.map((region) => (
                <li class="region">{region}</li>
              ))}
            </ul>
          )}
        </div>
      </li>
    ))}
  </ul>
</section>

<style>
  .coverage {
    display: grid;
    grid-template-columns: 320px minmax(0, 1fr);
    gap: 64px;
    align-items: start;
  }

  .heading {
    font-size: clamp(29px, 3.6vw, 36px);
    font-weight: 700;
    color: var(--color-ink);
  }

  .lede {
    margin-top: 14px;
    font-size: 16px;
    line-height: 1.7;
    color: var(--color-text-muted);
  }

  /* The original icon's tile: a 224px radius on 1024px is 21.875%. White, so
     it reads as no tile at all on this page - exactly as in the design. */
  .map-tile {
    margin-top: 24px;
    width: 100%;
    max-width: 320px;
    aspect-ratio: 1;
    border-radius: 21.875%;
    background: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  /* 900px map in a 1024px tile. */
  .map {
    display: block;
    width: 87.89%;
    height: auto;
  }

  /* Stronger than --color-border on purpose: these rules are the rows'
     only structure, and the hairline value washes out at this length. */
  .areas {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid #b9d0d2;
  }

  .area {
    display: flex;
    gap: 16px;
    padding-block: 22px;
    border-bottom: 1px solid #b9d0d2;
  }

  .pin {
    flex-shrink: 0;
    width: 22px;
    height: 22px;
    color: var(--color-ink);
  }

  .area-body {
    min-width: 0;
  }

  .area-name {
    font-size: 18px;
    font-weight: 600;
    color: var(--color-ink);
  }

  .area-desc {
    margin-top: 4px;
    font-size: 15.5px;
    line-height: 1.65;
    color: var(--color-text-muted);
  }

  .regions {
    list-style: none;
    margin: 12px 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .region {
    padding: 6px 13px;
    font-size: 13.5px;
    font-weight: 500;
    color: var(--color-ink);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 999px;
  }

  /* Stacked: heading, intro and map first, then the rows. The map stops
     short of full width - at phone width a full-bleed map would push the
     rows a whole screen down. */
  @media (max-width: 860px) {
    .coverage {
      grid-template-columns: 1fr;
      gap: 32px;
    }

    .map-tile {
      max-width: 240px;
    }
  }
</style>
