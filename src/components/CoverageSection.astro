---
// "Coverage" on the About page - option N5 from the About layout exploration:
// heading, intro and map on the left, the four coverage areas as ruled rows on
// the right, each with its regions as tags. Copy is the client's own.
//
// The map is the "Option B - coverage rings" icon from the client's Australia
// pin icon designs, kept exactly as drawn at the client's request: the same
// colours, rings, stroke weights and grey pins, scaled only. Its tile is
// white, so on this white page the map appears unframed - as it did in the
// approved design.

const AREAS: { name: string; description: string; regions?: string[] }[] = [
  {
    name: "Adelaide",
    description:
      "Based in Adelaide, servicing projects from the hills to the coast and surrounding regions.",
    regions: [
      "Adelaide",
      "Adelaide Hills",
      "Barossa Valley",
      "Fleurieu Peninsula",
    ],
  },
  {
    name: "South Australia - Statewide",
    description:
      "Covering all of South Australia, including regional towns, rural and remote areas, agricultural land, mining operations and major infrastructure sites.",
    regions: [
      "Mid North & Clare Valley",
      "Yorke Peninsula",
      "Eyre Peninsula",
      "Riverland & Murraylands",
      "Limestone Coast",
      "Flinders Ranges & Outback",
      "Kangaroo Island",
    ],
  },
  {
    name: "Wollongong, NSW & Surrounds",
    description:
      "With a secondary base in Wollongong, servicing projects across Sydney, the Illawarra and the South Coast.",
    regions: [
      "Sydney",
      "Illawarra",
      "Southern Highlands",
      "Shoalhaven",
      "South Coast",
    ],
  },
  {
    name: "Australia wide",
    description:
      "Available to travel nationwide for projects requiring specialist drone surveying services, with remote data processing also available.",
  },
];
---

<section class="coverage" aria-labelledby="coverage-heading">
  <div class="intro">
    <h2 class="heading" id="coverage-heading">Coverage</h2>
    <p class="lede">
      Operating from Adelaide, SA, with a secondary base in Wollongong, NSW.
      Servicing projects locally, regionally and across Australia.
    </p>

    {/* The original icon's markup, unchanged apart from its size: the tile
        and the map inside it keep the original's proportions (a 224px
        radius and a 900px map in a 1024px tile) as percentages, so it
        scales cleanly to whatever width the column gives it. */}
