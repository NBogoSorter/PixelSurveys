---
import { Image } from "astro:assets";

import heroImage from "../assets/hero-adelaide-city.jpg";

interface Props {
  title?: string;
  location?: string;
}

const {
  title = "Drone Survey & Mapping Services",
  location = "Adelaide based. Servicing sites across South Australia",
} = Astro.props;
---

<section class="hero">
  {/* width caps the variant that lands in src=: without it Astro emits one
      at the source's full 4000px, which nothing in the srcset would choose
      but which ships on every deploy.

      widths run to 3840 because a Retina laptop at 1440px needs 2880 real
      pixels and a 2560px monitor 2560; with 1920 the largest on offer, both
      were enlarging the photo 1.3-1.5x, which reads as soft and stretched.
      Only those screens download the big files.

      sizes is not simply 100vw, because the band is not always as wide as
      the photo is drawn. object-fit: cover fills the band's HEIGHT too, so
      where the band is tall for its width the 16:9 photo is drawn wider
      than the screen and cropped at the sides: the ~300px phone band draws
      it about 540px wide (300 x 16/9) on screens narrower than that. On
      desktop the band is always shallow enough that the photo is drawn at
      the screen's width. Telling the browser 100vw there made a phone fetch a
      file half the size it was drawn at - enlarged ~1.9x. Re-derive this
      number if the band's phone height or the photo's shape changes. */}
  <Image
    src={heroImage}
    alt=""
    width={1920}
    widths={[768, 1200, 1600, 1920, 2560, 3200, 3840]}
    sizes="(max-width: 540px) 540px, 100vw"
    loading="eager"
    fetchpriority="high"
    class="image"
  />

  <div class="container content">
    <h1 class="heading">{title}</h1>
    <p class="location">
      <svg
        class="pin"
        viewBox="0 0 24 24"
        width="16"
        height="16"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M12 21s7-6.2 7-11a7 7 0 1 0-14 0c0 4.8 7 11 7 11z" />
        <circle cx="12" cy="10" r="2.6" />
      </svg>
      <span>{location}</span>
    </p>
  </div>
</section>

<style>
  .hero {
    position: relative;
    /* A quarter taller than the About and Services banners (PageMasthead,
       20vw clamped 180-340px) at every width: 320px on a 1280px laptop,
       growing with the viewport to 420px. It was a 520-680px block, which
       the client found too big for a banner on 22 Oct 2026 - they asked for
       it to be just larger than the others. vw-based for the same reason
       as theirs: a fixed height on a wide screen crops a 16:9 photo to a
       thin strip that reads as zoomed in. The phone height is set in the
       640px block below. */
    min-height: clamp(320px, 25vw, 420px);
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  /* The hero photo, filling the band: the city skyline over the treetops
     and the parklands, supplied by the client on 22 Oct 2026. */
  .image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* The band shows a bit under half the 16:9 photo's height. 60% puts
       the skyline (at about 36-48% of the photo) across the top of the
       band, keeps the sun glare in the sky above it out of the frame, and
       lands the title on the skyline's base and the rooftops below - busy
       enough that the heading's shadow pair is doing real work, so check
       it first if this photo is ever replaced. The crop was 80% when the
       band was 520px tall and showed more of the photo. */
    object-position: center 60%;
  }

  /* Past about 1700px the band stops at its 420px ceiling while the photo
     keeps growing with the screen, so the band shows less and less of it
     and 60% starts cutting into the skyline. 50% keeps the whole skyline
     in frame on a 2560px monitor. */
  @media (min-width: 1700px) {
    .image {
      object-position: center 50%;
    }
  }

  /* No tint over the photo - the client wants it at full strength. The text
     shadows on the heading and location line are all that separate them from
     it now. */

  .content {
    position: relative;
    z-index: 1;
    /* Enough to keep the title off the band's edges; the band's own
       min-height does the rest. */
    padding-block: 56px;
  }

  .heading {
    color: #fff;
    font-size: clamp(38px, 6vw, 58px);
    font-weight: 700;
    line-height: 1.25;
    max-width: 640px;
    text-wrap: balance;
    /* The About masthead title's pair, for the same reason: with no wash on
       the photo these shadows are all that hold the title off the sky. The
       tight one edges the letterforms, the wide one darkens behind them. The
       old single 20% shadow was set when there was still a tint over the
       photo, and left the first line faint against the pale horizon. */
    text-shadow:
      0 2px 6px rgb(8 40 68 / 85%),
      0 6px 28px rgb(8 40 68 / 70%);
  }

  /* Sits straight on the image - no panel behind it - so the shadow is doing
     all the legibility work. It's heavier than the heading's for that reason:
     at 15px there's far less letter mass to stay readable over a busy photo.
     The crop above keeps it over the treeline; if the photo is ever replaced,
     check this line first - a bright patch under it would still beat it. */
  .location {
    display: flex;
    align-items: center;
    gap: 9px;
    margin-top: 22px;
    color: #fff;
    font-size: 15px;
    font-weight: 500;
    text-shadow: 0 1px 8px rgba(0, 0, 0, 0.55);
  }

  .pin {
    flex-shrink: 0;
    filter: drop-shadow(0 1px 4px rgba(0, 0, 0, 0.5));
  }

  @media (max-width: 640px) {
    /* Sized by what it holds: the title wraps to three lines and the
       location line to two at phone width, about 210px of text. */
    .hero {
      min-height: 300px;
    }

    /* On a phone the band is taller than the photo is wide, so cover crops
       the sides, not the top - the vertical position above does nothing
       here. Shift right instead, off the glare on the left and onto the
       bluer sky and the towers. */
    .image {
      object-position: 70% center;
    }

    .content {
      padding-block: 40px;
    }
  }
</style>
