---
import { Image } from "astro:assets";

import heroImage from "../assets/hero-adelaide-parklands.jpg";

interface Props {
  title?: string;
  location?: string;
}

const {
  title = "Drone Survey & Mapping Services",
  location = "Adelaide based. Servicing sites across South Australia",
} = Astro.props;
---

<section class="hero">
  {/* width caps the variant that lands in src=: without it Astro emits one
      at the source's full 4000px, which nothing in the srcset would choose
      but which ships on every deploy. */}
  <Image
    src={heroImage}
    alt=""
    width={1920}
    widths={[768, 1200, 1600, 1920]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
    class="image"
  />

  <div class="container content">
    <h1 class="heading">{title}</h1>
    <p class="location">
      <svg
        class="pin"
        viewBox="0 0 24 24"
        width="16"
        height="16"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M12 21s7-6.2 7-11a7 7 0 1 0-14 0c0 4.8 7 11 7 11z" />
        <circle cx="12" cy="10" r="2.6" />
      </svg>
      <span>{location}</span>
    </p>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 520px;
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  /* The hero photo, filling the band: the city skyline across the parklands,
     supplied by the client on 21 Oct 2026, replacing the 20 Oct panorama. */
  .image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Favour the lower part of a 16:9 frame. The skyline sits at its middle
       and the sun glare in its top-left corner is the brightest thing in it -
       exactly where the white title sits. Cropping from the top pushes the
       glare out of the band, lifts the skyline above the title and puts the
       title over the darker treeline, which is what keeps it readable with
       no wash. 60% was tried first: at 1280px the first line still sat on
       the glare, and at 1920px the title ran across the buildings. */
    object-position: center 80%;
  }

  /* No tint over the photo - the client wants it at full strength. The text
     shadows on the heading and location line are all that separate them from
     it now. */

  .content {
    position: relative;
    z-index: 1;
    padding-block: 100px;
  }

  .heading {
    color: #fff;
    font-size: clamp(38px, 6vw, 58px);
    font-weight: 700;
    line-height: 1.25;
    max-width: 640px;
    text-wrap: balance;
    /* The About masthead title's pair, for the same reason: with no wash on
       the photo these shadows are all that hold the title off the sky. The
       tight one edges the letterforms, the wide one darkens behind them. The
       old single 20% shadow was set when there was still a tint over the
       photo, and left the first line faint against the pale horizon. */
    text-shadow:
      0 2px 6px rgb(8 40 68 / 85%),
      0 6px 28px rgb(8 40 68 / 70%);
  }

  /* Sits straight on the image - no panel behind it - so the shadow is doing
     all the legibility work. It's heavier than the heading's for that reason:
     at 15px there's far less letter mass to stay readable over a busy photo.
     The crop above keeps it over the treeline; if the photo is ever replaced,
     check this line first - a bright patch under it would still beat it. */
  .location {
    display: flex;
    align-items: center;
    gap: 9px;
    margin-top: 22px;
    color: #fff;
    font-size: 15px;
    font-weight: 500;
    text-shadow: 0 1px 8px rgba(0, 0, 0, 0.55);
  }

  .pin {
    flex-shrink: 0;
    filter: drop-shadow(0 1px 4px rgba(0, 0, 0, 0.5));
  }

  @media (max-width: 640px) {
    .hero {
      min-height: 420px;
    }

    /* On a phone the band is taller than the photo is wide, so cover crops
       the sides, not the top - the vertical position above does nothing
       here. Shift right instead, off the glare on the left and onto the
       bluer sky and the towers. */
    .image {
      object-position: 70% center;
    }

    .content {
      padding-block: 70px;
    }
  }
</style>
