---
interface Props {
  title?: string;
  location?: string;
}

const {
  title = "Drone Survey & Aerial Mapping Services",
  location = "Adelaide based. Servicing sites across South Australia",
} = Astro.props;
---

<section class="hero">
  {/*
      Placeholder background - swap for the real aerial/drone photo.
      Put it in src/assets/ and render it here with astro:assets <Image>
      (class="image", object-fit: cover) in place of this div.
    */}
  <div class="image" aria-hidden="true"></div>
  <div class="overlay" aria-hidden="true"></div>

  <div class="container content">
    <h1 class="heading">{title}</h1>
    <p class="location">
      <svg
        class="pin"
        viewBox="0 0 24 24"
        width="16"
        height="16"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M12 21s7-6.2 7-11a7 7 0 1 0-14 0c0 4.8 7 11 7 11z" />
        <circle cx="12" cy="10" r="2.6" />
      </svg>
      <span>{location}</span>
    </p>
  </div>

  <svg
    class="wave"
    viewBox="0 0 1600 120"
    preserveAspectRatio="none"
    aria-hidden="true"
  >
    <path
      d="M0,40 C 260,110 480,10 760,55 C 1080,105 1320,15 1600,45 L1600,120 L0,120 Z"
      fill="var(--color-bg)"
    ></path>
  </svg>
</section>

<style>
  .hero {
    position: relative;
    min-height: 520px;
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .image {
    position: absolute;
    inset: 0;
    /* Placeholder aerial-field gradient - replace with the real photo. */
    background: linear-gradient(
      115deg,
      #4a7c3f 0%,
      #5d8f4a 35%,
      #7a9a5e 55%,
      #c9bd8f 80%,
      #d8cba0 100%
    );
  }

  .overlay {
    position: absolute;
    inset: 0;
    background: var(--color-hero-overlay);
  }

  .content {
    position: relative;
    z-index: 1;
    padding-block: 100px 140px;
  }

  .heading {
    color: #fff;
    font-size: clamp(38px, 6vw, 58px);
    font-weight: 700;
    line-height: 1.25;
    max-width: 640px;
    text-wrap: balance;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.2);
  }

  /* Sits straight on the image - no panel behind it - so the shadow is doing
     all the legibility work. It's heavier than the heading's for that reason:
     at 15px there's far less letter mass to stay readable over a busy photo.
     Worth revisiting once the real hero image lands (see the note above the
     placeholder) - a bright patch under this line would still beat it. */
  .location {
    display: flex;
    align-items: center;
    gap: 9px;
    margin-top: 22px;
    color: #fff;
    font-size: 15px;
    font-weight: 500;
    text-shadow: 0 1px 8px rgba(0, 0, 0, 0.55);
  }

  .pin {
    flex-shrink: 0;
    filter: drop-shadow(0 1px 4px rgba(0, 0, 0, 0.5));
  }

  .wave {
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 100%;
    height: 90px;
    display: block;
  }

  @media (max-width: 640px) {
    .hero {
      min-height: 420px;
    }

    .content {
      padding-block: 70px 100px;
    }
  }
</style>
