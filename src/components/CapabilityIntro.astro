---
// Heading + lede for the "What drone surveying can provide" section.
// No rule/divider beneath it by design - spacing alone separates it from
// whichever grid variant follows (CapabilitiesOpenGrid / CapabilitiesBorderedGrid).
//
// This renders above BOTH capability drafts, so the type scale is a prop
// rather than a hard-coded size: Draft A is on "generous" and Draft B on
// "comfortable", so the two scales can be compared side by side on the live
// page. Drop the prop once a scale and a draft are chosen.
interface Props {
  size?: "default" | "comfortable" | "generous";
}

const { size = "default" } = Astro.props;
---

<div class:list={["header", size !== "default" && size]}>
  <h2 class="heading">What drone surveying can provide</h2>
  <p class="lede">
    Drone surveys provide a safer and efficient way to capture detailed spatial
    data across a wide range of projects. Whether you need to measure
    earthworks, monitor progress, survey a large area or corridor, the data can
    be tailored to suit your project.
  </p>
</div>

<style>
  .header {
    padding-block: 8px 36px;
  }

  .heading {
    font-size: clamp(24px, 3vw, 30px);
    font-weight: 700;
    color: var(--color-ink);
    max-width: 30ch;
    text-wrap: balance;
  }

  .lede {
    margin-top: 14px;
    max-width: 62ch;
    font-size: 15px;
    line-height: 1.65;
    color: var(--color-text-muted);
  }

  /* Each scale moves the clamp's floor and vw rate by the same factor as its
     maximum, so the heading still steps down properly on narrow screens
     instead of jumping. */

  /* "Comfortable": heading 30 -> 33 (x1.1), lede 15 -> 16. */
  .comfortable .heading {
    font-size: clamp(26px, 3.3vw, 33px);
  }

  .comfortable .lede {
    font-size: 16px;
  }

  /* "Generous": heading 30 -> 36 (x1.2), lede 15 -> 17. */
  .generous .heading {
    font-size: clamp(29px, 3.6vw, 36px);
  }

  .generous .lede {
    font-size: 17px;
  }
</style>
