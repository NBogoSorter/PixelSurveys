---
// Full-bleed credentials strip - render outside the page's .container so the
// navy background reaches both edges, same pattern as the Capabilities panels.
import TrustIcon from "./TrustIcon.astro";
import { TRUST_POINTS } from "../data/trust-points";
---

<section class="bar">
  {/* Deliberately not .container - full width so the row spreads all the
      way to the page edges instead of centering in the 1200px column. */}
  <div class="grid">
    {TRUST_POINTS.map((point) => (
      <div class="item">
        <TrustIcon name={point.icon} class="icon" />
        <div class="body">
          <h3 class="title">{point.title}</h3>
          <p class="desc">{point.description}</p>
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  .bar {
    background: var(--color-ink);
    color: #fff;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 40px;
    padding: 32px 40px;
  }

  .item {
    display: flex;
    align-items: flex-start;
    gap: 14px;
  }

  /* Sized to sit level with the text block beside it. Also well clear of the
     ~43px floor below which these icons' strokes compute to under one CSS
     pixel and wash out - at 64px the stroke lands at 1.5px. */
  .item :global(.icon) {
    width: 64px;
    height: 64px;
    flex-shrink: 0;
    margin-top: 2px;
  }

  .title {
    font-size: 15px;
    font-weight: 600;
  }

  .desc {
    margin-top: 4px;
    font-size: 12.5px;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.8);
  }

  /* Drops to two columns earlier than the 980px it used to: with a 64px icon
     beside the text, four columns squeeze the copy to about 18 characters a
     line before this point, which breaks the descriptions into ragged stacks. */
  @media (max-width: 1150px) {
    .grid {
      grid-template-columns: 1fr 1fr;
      padding-inline: 24px;
    }
  }

  @media (max-width: 560px) {
    .grid {
      grid-template-columns: 1fr;
      padding-inline: 24px;
    }
  }
</style>
