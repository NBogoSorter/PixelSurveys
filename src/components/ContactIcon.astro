---
// Small line icons for the email and phone details. Tabler outline icons
// (icon-tabler-mail, icon-tabler-phone), supplied 29 Sept 2026. Paths and
// stroke weight are exactly as given.
//
// Changed from the originals, same adaptations the client's other icons got
// in TrustIcon:
//   - stroke="#ffffff" became currentColor, so one icon works on the navy
//     panel and would still work on white; the hover brightening is a colour
//     change, which a hard-coded white would ignore
//   - width/height attributes dropped; CSS sizes them
//   - xmlns dropped, since inline SVG in HTML does not need it
//   - the Tabler class list dropped in favour of the class this takes
//   - Tabler's leading <path d="M0 0h24v24H0z"> dropped: it has both fill and
//     stroke set to none, so it draws nothing and only exists to pin the
//     viewBox, which the viewBox attribute already does
//
// One <svg> with the paths chosen by name, rather than one <svg> per icon
// behind a conditional. That matters beyond tidiness: with two conditional
// expressions at the top level this component had no single root element,
// so Astro had nothing to stamp a parent's scope attribute onto. The svg
// went out carrying class="ico" but no data-astro-cid, and the parents'
// `.ico` rules - which compile to `.ico[data-astro-cid-...]` - matched
// nothing. Both icons rendered with no width, height or colour at all.
const PATHS = {
  email: [
    "M3 7a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-10",
    "M3 7l9 6l9 -6",
  ],
  phone: [
    "M5 4h4l2 5l-2.5 1.5a11 11 0 0 0 5 5l1.5 -2.5l5 2v4a2 2 0 0 1 -2 2a16 16 0 0 1 -15 -15a2 2 0 0 1 2 -2",
  ],
} as const;

interface Props {
  name: keyof typeof PATHS;
  class?: string;
}

const { name, class: className } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {PATHS[name].map((d) => <path d={d} />)}
</svg>

<style>
  /* A size of its own, so the icon can never render unsized even if a parent's
     rule fails to reach it. em, so it tracks whatever text it sits beside.
     Parents override this for an exact pixel size. */
  svg {
    width: 1.05em;
    height: 1.05em;
    flex-shrink: 0;
  }
</style>
