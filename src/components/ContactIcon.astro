---
// Small line icons for the email and phone details, in the same house style as
// TrustIcon/CapabilityIcon: inline SVG so it inherits colour from CSS, no
// width/height attributes so CSS sizes it, aria-hidden because the text beside
// it already says what it is.
//
// Drawn on a 24x24 grid rather than the 128x128 the client's icons use. These
// render at ~17px, and 128-grid geometry with stroke-width 3 scales down to a
// sub-pixel stroke that renders muddy at this size.
interface Props {
  name: "email" | "phone";
  class?: string;
}

const { name, class: className } = Astro.props;
---

{name === "email" && (
  <svg
    class={className}
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.8"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <rect x="2.75" y="5" width="18.5" height="14" rx="2.5" />
    <path d="M3.5 7.5 10.9 13a1.9 1.9 0 0 0 2.2 0l7.4-5.5" />
  </svg>
)}

{name === "phone" && (
  <svg
    class={className}
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.8"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path
      d="M7.1 3.6a1.6 1.6 0 0 1 1.6 1.1l.9 2.6a1.6 1.6 0 0 1-.5 1.8l-1.2.9a12.4 12.4 0 0 0 5.6 5.6l.9-1.2a1.6 1.6 0 0 1 1.8-.5l2.6.9a1.6 1.6 0 0 1 1.1 1.6v2a1.9 1.9 0 0 1-2.1 1.9C10.5 19.6 4.4 13.5 3.7 5.7A1.9 1.9 0 0 1 5.6 3.6Z"
    />
  </svg>
)}
