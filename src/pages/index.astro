---
import CapabilitiesOpenGrid from "../components/CapabilitiesOpenGrid.astro";
import CapabilityIntro from "../components/CapabilityIntro.astro";
import ContactFormB from "../components/ContactFormB.astro";
import FaqAccordion from "../components/FaqAccordion.astro";
import Hero from "../components/Hero.astro";
import IntroSection from "../components/IntroSection.astro";
import ServicesGrid from "../components/ServicesGrid.astro";
import TrustBar from "../components/TrustBar.astro";
import Base from "../layouts/Base.astro";
---

<Base>
  <Hero />
  <IntroSection />
  <ServicesGrid />

  <div class="capabilities">
    <div class="container">
      <CapabilityIntro />
    </div>
    {/* Full-bleed: sits outside .container on purpose so its background runs
        edge to edge. */}
    <CapabilitiesOpenGrid />
  </div>

  <TrustBar />
  <FaqAccordion />

  {/* Full-bleed, and last before the footer: its navy background butts
      straight into the footer's gradient rule with no white gap. */}
  <ContactFormB />
</Base>

<style>
  .capabilities {
    padding-top: 48px;
    border-top: 1px solid var(--color-border);
  }
</style>
