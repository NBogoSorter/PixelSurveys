---
import CapabilitiesBorderedGrid from "../components/CapabilitiesBorderedGrid.astro";
import CapabilitiesOpenGrid from "../components/CapabilitiesOpenGrid.astro";
import CapabilityIntro from "../components/CapabilityIntro.astro";
import ContactFormB from "../components/ContactFormB.astro";
import FaqAccordion from "../components/FaqAccordion.astro";
import Hero from "../components/Hero.astro";
import IntroSection from "../components/IntroSection.astro";
import ServicesGrid from "../components/ServicesGrid.astro";
import TrustBar from "../components/TrustBar.astro";
import Base from "../layouts/Base.astro";
---

<Base>
  <Hero />
  <IntroSection />
  <ServicesGrid />

  {/* Draft comparison, moved down from /capabilities-preview/ - remove the loser once picked. */}
  <div class="draft">
    <div class="container">
      <p class="draft-label">Draft A - open grid, no card borders</p>
      <CapabilityIntro size="generous" />
    </div>
    {/* Full-bleed: sits outside .container on purpose so its background runs edge to edge. */}
    <CapabilitiesOpenGrid />
  </div>

  <div class="draft">
    <div class="container">
      <p class="draft-label">Draft B - bordered grid</p>
      <CapabilityIntro size="comfortable" />
    </div>
    {/* Full-bleed, same as Draft A above. */}
    <CapabilitiesBorderedGrid />
  </div>

  <TrustBar />
  <FaqAccordion />

  {/* Full-bleed, and last before the footer: its navy background butts
      straight into the footer's gradient rule with no white gap. */}
  <ContactFormB />
</Base>

<style>
  .draft {
    padding-top: 48px;
    padding-bottom: 48px;
    border-top: 1px solid var(--color-border);
  }

  .draft-label {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 8px;
  }
</style>
