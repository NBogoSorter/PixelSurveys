---
// Option F5 from the About layout exploration: a photo behind the heading
// with no wash over it (PageMasthead), body paragraphs at a single uniform
// weight, and the client's last paragraph pulled onto a tinted band with the
// call to action beside it.
//
// This page used to render IntroSection, repeating the homepage's two
// paragraphs verbatim. The client supplied its own copy on 20 Oct 2026, so
// the two pages no longer say the same thing.
import { Image } from "astro:assets";

import aboutImage from "../assets/about-avenue-dusk.jpg";
import CoverageSection from "../components/CoverageSection.astro";
import PageMasthead from "../components/PageMasthead.astro";
import TrustBar from "../components/TrustBar.astro";
import Base from "../layouts/Base.astro";

/**
 * Supporting photos, shown between the copy and the closing band.
 *
 * Empty until the client supplies them, and the grid below does not render
 * while it is - a dashed placeholder box was fine on the services page while
 * the site sat behind the pre-launch gate, but this page is public and an
 * empty frame reads as broken rather than as pending.
 *
 * To add them: put the files in src/assets/, import them here and push
 * { src, alt } objects. Two is the layout; one would sit at half width.
 *
 * The brief, from the client's chosen design: one of the team or equipment
 * on site, one of a finished deliverable.
 */
const PHOTOS: { src: ImageMetadata; alt: string }[] = [];
---

<Base
  title="About"
  description="Pixel Surveys combines professional surveying knowledge with drone technology to deliver accurate, practical spatial data. Based in Adelaide, South Australia."
>
  {/* The avenue at dusk, supplied 22 Oct 2026: a 16:9 frame with the sun
      high in the sky over its top 40%, the city skyline at about 39-47% of
      its height, and dark trees and rooftops below. 55% takes the strip from
      about 35% to 71% at 1280px - a band of sky, the whole skyline across
      the top, and the title at roughly 59-67%, on the dark treeline. The sun
      stays out of the band on every desktop width; on a phone, where the
      band sits on its 180px floor and shows most of the photo's height, it
      appears above the skyline, but the title still sits low on the dark
      foreground. */}
  <PageMasthead
    image={aboutImage}
    title="About Pixel Surveys"
    position="center 55%"
  />

  <section class="body">
    <div class="container">
      <p class="para">
        Pixel Surveys combines professional surveying knowledge with drone
        technology to deliver accurate, practical spatial data for a wide range
        of projects. Based in Adelaide, South Australia, Pixel Surveys works
        with clients across the state and interstate, providing data solutions
        customised to each project.
      </p>
      <p class="para">
        With experience in surveying, drone operations and spatial data
        processing, Pixel Surveys understands the importance of reliable
        information that can be used confidently for planning, design,
        measurement and monitoring. Each project is approached with attention to
        detail, an understanding of surveying principles and a focus on
        delivering useful, fit for purpose data.
      </p>
      <p class="para">
        Drone technology provides an efficient way to capture detailed
        information across large areas, complex sites and locations that can be
        difficult to access using traditional methods. From aerial imagery and
        terrain models to point clouds, volume calculations and repeat site
        monitoring, data can be delivered in formats suited to each
        project&rsquo;s requirements and existing workflows.
      </p>

      {PHOTOS.length > 0 && (
        <div class="photos">
          {PHOTOS.map((photo) => (
            <Image
              src={photo.src}
              alt={photo.alt}
              width={760}
              widths={[380, 560, 760]}
              sizes="(max-width: 760px) 100vw, 46vw"
              class="photo"
            />
          ))}
        </div>
      )}

      {/* Option N5 from the About layout exploration, added under the
          client's copy on 21 Oct 2026. A wrapper because CoverageSection's
          root carries that component's scope, not this page's - see the
          :global note in SiteFooter. */}
      <div class="coverage-wrap">
        <CoverageSection />
      </div>
    </div>
  </section>

  <section class="closing">
    <div class="container closing-inner">
      <p class="closing-text">
        Pixel Surveys is committed to providing a reliable service built around
        technical expertise, clear communication and a detailed understanding of
        each project&rsquo;s needs.
      </p>
      <a href="/contact/" class="button cta">Contact Us</a>
    </div>
  </section>

  <TrustBar />
</Base>

<style>
  .body {
    padding-block: 48px 8px;
  }

  .para {
    max-width: 70ch;
    font-size: 16.5px;
    line-height: 1.75;
    color: var(--color-text-muted);
  }

  /* Uniform weight and size throughout - the client asked for no emphasis on
     the opening paragraph, so the only separation between them is space. */
  .para + .para {
    margin-top: 20px;
  }

  .photos {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
    margin-top: 34px;
  }

  .photo {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
  }

  .coverage-wrap {
    margin-top: var(--space-section);
  }

  .closing {
    background: var(--color-surface);
    margin-top: 44px;
    padding-block: 36px;
  }

  .closing-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 48px;
  }

  .closing-text {
    max-width: 52ch;
    font-size: 20px;
    font-weight: 500;
    line-height: 1.6;
    color: var(--color-ink);
  }

  /* Look comes from the global .button - this was a pill with an arrow and
     uppercase text until the client asked for one button style throughout
     on 22 Oct 2026. This only stops it squeezing beside the sentence. */
  .cta {
    flex-shrink: 0;
  }

  @media (max-width: 760px) {
    .photos {
      grid-template-columns: 1fr;
    }

    /* Stacked, the button sits under the sentence it belongs to rather than
       stretching across the page. */
    .closing-inner {
      flex-direction: column;
      align-items: flex-start;
      gap: 24px;
    }
  }
</style>
