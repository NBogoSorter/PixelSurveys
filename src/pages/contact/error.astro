---
import PageHeader from "../../components/PageHeader.astro";
import Base from "../../layouts/Base.astro";
---

{/* Redirect target for quote.php when a no-JavaScript submission fails. */}
<Base title="Request not sent">
  <PageHeader
    title="Your request wasn't sent"
    lede="Check that your name, email and project details are filled in, then try again."
  />
  <div class="container back">
    <a href="/contact/">Back to the form</a>
  </div>
</Base>

<style>
  .back {
    padding-bottom: 80px;
  }

  .back a {
    font-weight: 600;
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
</style>
