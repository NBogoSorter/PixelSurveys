---
// The same contact section the homepage ends with, rather than a second,
// separate form. It carries its own heading, lede and contact details, so
// there is no PageHeader above it - two stacked headings ("Request a Quote"
// then "Let's Discuss Your Next Project") said the same thing twice.
//
// headingLevel={1} because here it is the whole page: without it this page
// would have no <h1>.
import ContactFormB from "../../components/ContactFormB.astro";
import Base from "../../layouts/Base.astro";
---

<Base
  title="Contact"
  description="Request a quote for drone survey and aerial mapping services."
>
  <ContactFormB headingLevel={1} />
</Base>
