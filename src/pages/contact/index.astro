---
import PageHeader from "../../components/PageHeader.astro";
import QuoteForm from "../../components/QuoteForm.astro";
import Base from "../../layouts/Base.astro";
---

<Base
  title="Contact"
  description="Request a quote for drone survey and aerial mapping services."
>
  <PageHeader
    title="Request a Quote"
    lede="Tell us about the site and what you need from it, and we'll get back to you with a quote."
  />
  <section class="container form-section">
    <QuoteForm />
  </section>
</Base>

<style>
  .form-section {
    padding-bottom: 80px;
  }
</style>
