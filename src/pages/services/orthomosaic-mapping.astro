---
// Service detail page: Orthomosaic Mapping. The first of the per-service pages
// under /services/. Sections follow the client's brief, in their order.
//
// PLACEHOLDER DATA - all of the following are unverified and must be replaced
// before launch (tracked in README.md, "Before launch"):
//   - the GSD table's capture heights and cm/px figures
//   - [XX] mm typical horizontal accuracy in "Accuracy and control"
//   - [XX] hectares per flight in the FAQ
//   - every image placeholder
//   - the /applications/ and /services/ links below, which are the brief's
//     "plausible URLs" and mostly have no page behind them yet
import Base from "../../layouts/Base.astro";

const BREADCRUMB = [
  { label: "Home", href: "/" },
  { label: "Services", href: "/services/" },
  { label: "Aerial Imagery & Mapping", href: "/services/" },
];

const CAPABILITIES = [
  {
    title: "Measure directly",
    line: "Take distances and areas straight off the image without returning to site",
    icon: "ruler",
  },
  {
    title: "CAD and GIS background",
    line: "Drop a current, accurate base layer under your design",
    icon: "layers",
  },
  {
    title: "Feature extraction",
    line: "Digitise kerbs, fences, drainage, hardstand and site detail",
    icon: "vector",
  },
  {
    title: "Site documentation",
    line: "An accurate record of conditions on a specific date",
    icon: "document",
  },
  {
    title: "Area calculations",
    line: "Measure disturbance, footprint, hardstand or vegetated area",
    icon: "area",
  },
  {
    title: "Change comparison",
    line: "Overlay against design or an earlier capture to see what moved",
    icon: "compare",
